<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        {# `viewport-fit=cover` est la condition pour que env(safe-area-inset-bottom)
           soit non nul : sans lui, --kd-navbar-h ignore la barre gestuelle iOS et
           la nav basse passe dessous en mode standalone. #}
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}Kadens{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Kadens — bibliothèque d'exercices, séances, plans multi-semaines et calendrier d'entraînement.{% endblock %}">

        {{ include('components/_pwa_head.html.twig') }}

        {% block stylesheets %}
            {# Polices « Presse » self-hostées : chargées via AssetMapper
               (app.css → fonts.css). Plus de dépendance Google Fonts. #}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# Évitement du chrome : le header est collant et porte 4 entrées + un
           menu, qu'un utilisateur clavier retabulerait à chaque navigation.
           Visible seulement une fois focalisé (.kd-skip). #}
        <a class="kd-skip" href="#main">Aller au contenu</a>

        {% if app.user %}
            {{ include('components/_header.html.twig') }}
        {% endif %}
        <main id="main" class="{% block main_class %}kd-page{% endblock %}">
            {% block body %}{% endblock %}
        </main>

        {# Service worker : PROD SEULEMENT. En dev il n'apporte rien (rien à
           installer) et un SW qui traîne masque les modifications — c'est ce qui
           avait fait suspendre la Phase 9. Pour le tester en local : APP_ENV=prod.
           Enregistré ici plutôt que dans app.js pour rester conditionnable côté
           serveur ; `navigator.serviceWorker` n'existe qu'en contexte sécurisé
           (HTTPS ou localhost), le test suffit à ne rien casser ailleurs. #}
        {% if app.environment == 'prod' %}
            <script>
                if ('serviceWorker' in navigator) {
                    window.addEventListener('load', function () {
                        navigator.serviceWorker.register('/sw.js');
                    });
                }
            </script>
        {% else %}
            {# Filet : un SW enregistré en testant APP_ENV=prod en local reste actif
               sur localhost et servirait du HTML en cache une fois revenu en dev. #}
            <script>
                if ('serviceWorker' in navigator) {
                    navigator.serviceWorker.getRegistrations()
                        .then(function (registrations) {
                            registrations.forEach(function (registration) { registration.unregister(); });
                        })
                        .catch(function () {});
                }
            </script>
        {% endif %}
    </body>
</html>
