{% extends 'base.html.twig' %}

{% block title %}Calendrier — {{ monthLabel }}{% endblock %}

{% block body %}
    {% set dayNames = {1: 'Lun', 2: 'Mar', 3: 'Mer', 4: 'Jeu', 5: 'Ven', 6: 'Sam', 7: 'Dim'} %}

    {% for message in app.flashes('success') %}
        <div class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }}{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="kd-flash kd-flash--error" role="alert">{{ ux_icon('lucide:calendar-x') }}{{ message }}</div>
    {% endfor %}

    <div class="kd-pagehead">
        <div>
            <p class="kd-eyebrow">Planning</p>
            <h1 class="kd-title">{{ monthLabel }}</h1>
        </div>

        <div class="kd-calhead">
            {# Bascule Mois / Semaine — la semaine ouverte est celle contenant
               aujourd'hui si le mois affiché est le mois courant, sinon son 1er jour. #}
            <div class="kd-viewtoggle" role="group" aria-label="Type de vue">
                <a class="kd-viewtoggle__btn is-active" aria-current="page" href="{{ path('app_calendar_month', {year: year, month: month}) }}">
                    {{ ux_icon('lucide:calendar-days') }} Mois
                </a>
                <a class="kd-viewtoggle__btn" href="{{ path('app_calendar_week', {date: weekPivot}) }}">
                    {{ ux_icon('lucide:calendar-range') }} Semaine
                </a>
            </div>

            <nav class="kd-actionbar__end" aria-label="Navigation du calendrier">
                <a class="kd-btn kd-btn--secondary kd-btn--sm" href="{{ path('app_calendar_month', {year: prev.year, month: prev.month}) }}" aria-label="Mois précédent">
                    {{ ux_icon('lucide:arrow-left') }}
                </a>
                <a class="kd-btn kd-btn--ghost kd-btn--sm" href="{{ path('app_calendar_index') }}">Aujourd'hui</a>
                <a class="kd-btn kd-btn--secondary kd-btn--sm" href="{{ path('app_calendar_month', {year: next.year, month: next.month}) }}" aria-label="Mois suivant">
                    {{ ux_icon('lucide:arrow-right') }}
                </a>
                <a class="kd-btn kd-btn--secondary kd-btn--sm" href="{{ path('app_export_schedule', {year: year, month: month}) }}">
                    {{ ux_icon('lucide:file-down') }} Exporter
                </a>
            </nav>
        </div>
    </div>

    <div data-controller="caladd">
        {{ include('calendar/_addbar.html.twig') }}

        <div class="kd-cal">
            <div class="kd-cal__grid">
                {% for iso, label in dayNames %}
                    <div class="kd-cal__dow">{{ label }}</div>
                {% endfor %}

                {% for week in weeks %}
                    {% for cell in week %}
                        {% set weekend = cell.date|date('N') in ['6', '7'] %}
                        <div class="kd-calday{{ not cell.inMonth ? ' kd-calday--out' }}{{ cell.isToday ? ' kd-calday--today' }}{{ weekend ? ' kd-calday--weekend' }}">
                            <span class="kd-calday__num">{{ cell.date|date('j') }}</span>

                            {% if cell.scheduled|length %}
                                <div class="kd-calday__events">
                                    {% for scheduled in cell.scheduled %}
                                        {{ include('components/_cal_event.html.twig', {
                                            scheduled: scheduled,
                                            fw: flattened[scheduled.workout.id],
                                            statuses: statuses,
                                            overdue: cell.overdue and scheduled.status.value == 'planned',
                                        }) }}
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <button type="button" class="kd-calday__add"
                                    data-action="caladd#openWorkout"
                                    data-caladd-date-param="{{ cell.date|date('Y-m-d') }}"
                                    aria-label="Ajouter une séance le {{ cell.date|date('d/m') }}">
                                {{ ux_icon('lucide:plus') }}
                            </button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
