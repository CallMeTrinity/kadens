{# ============================================================================
   Composant activité — source unique du couple (icône Lucide, couleur) par
   ActivityType. À réutiliser partout où une activité s'affiche (séances,
   calendrier, etc.).

   L'activité se lit deux fois : par l'ICÔNE, toujours présente, et par la
   COULEUR de sa palette (défaut ou réglage du lecteur, cf. ActivityPalette).
   La couleur passe par les classes porteuses `kd-act--{clé}` / `kd-act2--{clé}`
   (components.css), jamais par une valeur écrite dans le template.

   Usage :
     {% import 'components/_activity.html.twig' as activity %}
     {{ activity.badge(exercise.activity) }}    {# pastille pleine icône + label #}
     {{ activity.icon(exercise.activity) }}      {# 'lucide:...'                  #}
     {{ activity.modifier(exercise.activity) }}  {# 'run'|'gym'|'swim'|'bike'|…   #}
     {{ activity.surface(fw.activities) }}       {# 'kd-act--gym kd-act2--run'    #}
   ============================================================================ #}

{%- macro icon(activity) -%}
    {{- {
        'gym': 'lucide:dumbbell', 'running': 'lucide:footprints',
        'swimming': 'lucide:waves', 'cycling': 'lucide:bike',
        'mobility': 'lucide:person-standing', 'other': 'lucide:circle-dot',
    }[activity.value] ?? 'lucide:circle-dot' -}}
{%- endmacro -%}

{%- macro modifier(activity) -%}
    {{- activity ? activity.cssKey : '' -}}
{%- endmacro -%}

{#- Les classes de couleur d'une séance : la PREMIÈRE activité (la dominante,
    cf. WorkoutMetrics::rankedActivities) en aplat, la deuxième en bande. Une
    séance sans activité (vide, séance libre) ne rend rien : le composant garde
    alors son fond neutre. -#}
{%- macro surface(activities) -%}
    {%- set first = activities|first -%}
    {%- set second = activities|length > 1 ? activities[1] : null -%}
    {{- first ? 'kd-act--' ~ first.cssKey -}}
    {{- second ? ' kd-act2--' ~ second.cssKey -}}
{%- endmacro -%}

{%- macro badge(activity, with_label = true) -%}
    {%- import _self as self -%}
    <span class="kd-badge kd-badge--act kd-act--{{ self.modifier(activity) }}">
        {{- ux_icon(self.icon(activity)|trim) -}}
        {%- if with_label %} {{ activity.label }}{% endif -%}
    </span>
{%- endmacro -%}
