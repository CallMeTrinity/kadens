{# ============================================================================
   Pastille de séance datée + modale d'édition — partagée par la vue mois
   (`calendar/index`) et la vue semaine (`calendar/week`).

   Trois zones cliquables : la séance datée, le cycle rapide du statut (prévu →
   fait → manqué) et un œil vers la même page. Filet gauche = statut (seul cas où
   la couleur code l'état, pas l'activité).

   **Disposition** : le contenu prend la case entière, les deux actions passent en
   rangée dessous. Sur ordinateur une colonne de calendrier est plus étroite que
   l'écran d'un téléphone — trois zones côte à côte ne laissaient au titre qu'une
   quarantaine de pixels. Sous 560px, où l'agenda vertical rend la pleine largeur,
   le CSS repasse en ligne. L'ordre du DOM suit la disposition par défaut
   (contenu, puis ses actions) ; c'est la disposition en ligne qui déplace le
   bouton de statut par `order`.

   Le contenu est un **lien** vers /schedule/{id}, intercepté par `dialog#openFine`
   au pointeur fin uniquement : sur ordinateur il ouvre la modale rapide (statut /
   déplacer / retirer), au doigt il navigue. L'œil, lui, n'est jamais intercepté —
   c'est le chemin vers la séance entière, y compris sur ordinateur. Le lien reste
   le comportement de base : sans JS, tout mène à la page.

   Aperçu du contenu au survol via le composant `_plan_preview` (Popover API),
   souris uniquement (cf. preview_controller).

   Attend :
     - scheduled : ScheduledWorkout
     - fw        : PlanFlattener::flattenWorkout(scheduled.workout) (aperçu + méta),
                   **null** si la séance datée n'a pas de source (séance libre, ou
                   séance de bibliothèque supprimée) : il n'y a alors ni aperçu ni
                   méta, le titre retombe sur le snapshot `displayTitle` et la
                   pastille porte la marque « Libre »
     - statuses  : ScheduledStatus::cases()
     - detailed  : bool (optionnel) — carte haute de la vue semaine (méta + note)
     - overdue   : bool (optionnel) — séance passée encore « prévue »
   ============================================================================ #}
{% import 'components/_activity.html.twig' as activity %}
{% set fw = fw|default(null) %}
{% set workout = scheduled.workout %}
{# Séance datée sans source : séance libre montée au fil de l'eau, ou séance de
   bibliothèque supprimée depuis. Rien à annoncer d'un programme — et c'est
   justement l'information à porter. #}
{% set freeform = workout is null %}
{% set title = scheduled.displayTitle %}
{% set st = scheduled.status.value %}
{% set nextStatus = scheduled.status.next %}
{% set detailed = detailed|default(false) %}
{% set overdue = overdue|default(false) %}

<div id="cal-event-{{ scheduled.id }}" class="kd-calevent kd-calevent--{{ st }}{{ detailed ? ' kd-calevent--detailed' }}{{ overdue ? ' is-overdue' }}"
     data-controller="dialog preview"
     data-action="mouseenter->preview#show mouseleave->preview#hide">
    {# La séance datée. Modale au pointeur fin, navigation au doigt. #}
    <a href="{{ path('app_scheduled_workout_show', {id: scheduled.id}) }}"
       class="kd-calevent__open" data-action="dialog#openFine" title="{{ title }}">
        <span class="kd-calevent__title">{{ title }}</span>
        {% if freeform %}
            <span class="kd-calevent__meta">
                {{ include('components/_freeform_mark.html.twig') }}
            </span>
        {% elseif fw and (fw.activities|length or workout.estimatedDurationMinutes) %}
            <span class="kd-calevent__meta">
                {% for act in fw.activities %}
                    <span class="kd-calevent__act kd-calevent__act--{{ activity.modifier(act) ?: 'neutral' }}"
                          title="{{ act.label }}">{{ ux_icon(activity.icon(act)|trim) }}</span>
                {% endfor %}
                {% if workout.estimatedDurationMinutes %}
                    <span class="kd-calevent__dur">{{ ux_icon('lucide:clock') }}{{ workout.estimatedDurationMinutes }}′</span>
                {% endif %}
                {% if detailed and fw.exerciseCount %}
                    <span class="kd-calevent__exos">{{ fw.exerciseCount }} exo{{ fw.exerciseCount > 1 ? 's' }}</span>
                {% endif %}
            </span>
        {% endif %}
        {% if detailed and overdue %}
            <span class="kd-calevent__flag">{{ ux_icon('lucide:calendar-clock') }} En retard</span>
        {% endif %}
    </a>

    {# Rangée d'actions. Cycle rapide du statut (prévue → faite → manquée), puis
       l'œil : voir la séance en entier. L'œil n'est jamais intercepté — c'est le
       seul chemin vers le programme complet depuis le calendrier. #}
    <form method="post" action="{{ path('app_scheduled_workout_cycle_status', {id: scheduled.id}) }}" class="kd-calevent__statusform">
        <input type="hidden" name="_token" value="{{ csrf_token('cycle' ~ scheduled.id) }}">
        {# Vue courante : permet au flux Turbo de re-rendre la pastille à l'identique. #}
        <input type="hidden" name="detailed" value="{{ detailed ? 1 : 0 }}">
        <button type="submit" class="kd-calevent__toggle"
                aria-label="Statut : {{ scheduled.status.label }}. Marquer « {{ nextStatus.label }} »"
                title="{{ scheduled.status.label }} · cliquer pour marquer « {{ nextStatus.label }} »">
            {% if st == 'done' %}{{ ux_icon('lucide:check') }}
            {% elseif st == 'missed' %}{{ ux_icon('lucide:x') }}
            {% else %}{{ ux_icon('lucide:circle-dot') }}{% endif %}
        </button>
    </form>

    <a href="{{ path('app_scheduled_workout_show', {id: scheduled.id}) }}"
       class="kd-calevent__eye" aria-label="Voir « {{ title }} » en entier">
        {{ ux_icon('lucide:eye') }}
    </a>

    <dialog class="kd-modal" data-dialog-target="dialog" data-action="click->dialog#backdrop">
        <div class="kd-modal__card">
            <div class="kd-modal__head">
                <div>
                    <h2 class="kd-modal__title">{{ title }}</h2>
                    <p class="kd-modal__sub">{{ scheduled.scheduledDate|date('d/m/Y') }}</p>
                </div>
                <button type="button" class="kd-modal__close" data-action="dialog#close" aria-label="Fermer">
                    {{ ux_icon('lucide:x') }}
                </button>
            </div>

            <div class="kd-modal__meta">
                <span class="kd-badge kd-badge--{{ st }}"><span class="kd-badge__dot"></span>{{ scheduled.status.label }}</span>
                {% if workout %}
                    <a class="kd-btn kd-btn--ghost kd-btn--sm" href="{{ path('app_workout_show', {id: workout.id}) }}">
                        {{ ux_icon('lucide:external-link') }} Voir la séance
                    </a>
                {% else %}
                    {# Sans source, il n'y a aucune séance de bibliothèque à ouvrir :
                       la marque prend la place du lien plutôt que de le laisser vide. #}
                    {{ include('components/_freeform_mark.html.twig') }}
                {% endif %}
            </div>

            {# Prévu vs réalisé : marquer fait/manqué en un clic + noter un écart léger. #}
            <div class="kd-modal__section">
                <p class="kd-modal__section-title">Statut</p>
                <form method="post" action="{{ path('app_scheduled_workout_status', {id: scheduled.id}) }}" class="kd-modal__form">
                    <input type="hidden" name="_token" value="{{ csrf_token('status' ~ scheduled.id) }}">
                    <input type="hidden" name="detailed" value="{{ detailed ? 1 : 0 }}">
                    <div class="kd-field">
                        <textarea name="completionNotes" rows="2" class="kd-input kd-input--area" placeholder="Écart / ressenti (optionnel)">{{ scheduled.completionNotes }}</textarea>
                    </div>
                    <div class="kd-segmented" role="group" aria-label="Marquer le statut">
                        {% for status in statuses %}
                            <button type="submit" name="status" value="{{ status.value }}"
                                    class="kd-segbtn kd-segbtn--{{ status.value }}{{ status == scheduled.status ? ' is-active' }}">
                                {% if status.value == 'done' %}{{ ux_icon('lucide:check') }}
                                {% elseif status.value == 'missed' %}{{ ux_icon('lucide:x') }}
                                {% else %}{{ ux_icon('lucide:circle-dot') }}{% endif %}
                                {{ status.label }}
                            </button>
                        {% endfor %}
                    </div>
                </form>
            </div>

            <div class="kd-modal__section">
                <p class="kd-modal__section-title">Déplacer</p>
                <form method="post" action="{{ path('app_scheduled_workout_move', {id: scheduled.id}) }}" class="kd-modal__inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('move' ~ scheduled.id) }}">
                    <div class="kd-field">
                        <input type="date" name="scheduledDate" value="{{ scheduled.scheduledDate|date('Y-m-d') }}" class="kd-input" required>
                    </div>
                    <button type="submit" class="kd-btn kd-btn--secondary">{{ ux_icon('lucide:calendar-clock') }} Déplacer</button>
                </form>
            </div>

            <div class="kd-modal__section">
                <form method="post" action="{{ path('app_scheduled_workout_delete', {id: scheduled.id}) }}" onsubmit="return confirm('Retirer cette séance du planning ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ scheduled.id) }}">
                    <button type="submit" class="kd-btn kd-btn--danger">{{ ux_icon('lucide:trash-2') }} Retirer du planning</button>
                </form>
            </div>
        </div>
    </dialog>

    {# Sans source, il n'y a aucun programme à prévisualiser. #}
    {% if fw %}
        {{ include('components/_plan_preview.html.twig', {fw: fw}) }}
    {% endif %}
</div>
