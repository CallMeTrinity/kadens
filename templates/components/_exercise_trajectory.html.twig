{# Bloc « Ma trajectoire » sur la fiche d'un exercice (KL-50) : record, dernière
   performance, courbes de progression et dix dernières séances.

   Attend `trajectory` = sortie de ExerciseTrajectory::for(), ou null, et
   `progress` = sortie de ExerciseProgress::for() (courbes fenêtrées), qui
   demande aussi `exercise` pour construire les liens de fenêtre. **Null =
   rien** : un exercice jamais fait n'affiche pas un cadre vide, il n'affiche pas
   de bloc. C'est la seule condition de rendu, et elle est ici.

   L'historique montré est celui d'UNE personne, jamais un mélange : un exercice
   de la bibliothèque globale est pratiqué par tout le monde. Par défaut c'est
   l'utilisateur connecté ; `subject` (un athlète coaché) le remplace, et le
   titre comme le lead le disent à l'écran — un chiffre de performance ne doit
   jamais laisser douter de qui l'a produit. Le contrôleur est garant de la
   correspondance entre `subject` et l'historique passé.

   Les courbes ont leur propre composant (`_exercise_progress`), qui porte sa
   fenêtre de temps. #}
{% import 'components/_set_type.html.twig' as settype %}
{% set subject = subject|default(null) %}
{% set progress = progress|default(null) %}

{% if trajectory %}
    <section class="kd-card kd-extraj">
        <div class="kd-card__head">
            <h2 class="kd-card__title">
                {{ ux_icon('lucide:activity') }}
                {{ subject ? 'Sa trajectoire' : 'Ma trajectoire' }}
            </h2>
        </div>
        <p class="kd-extraj__lead">
            {% if subject %}
                Ce que {{ subject.userIdentifier }} a réellement fait sur cet exercice, toutes séances et tous plans confondus. Son historique seul.
            {% else %}
                Ce que tu as réellement fait sur cet exercice, toutes séances et tous plans confondus. Ton historique seul.
            {% endif %}
        </p>

        <dl class="kd-wk__kpis kd-wk__kpis--logged">
            {% if trajectory.best %}
                <div class="kd-wk__kpi kd-wk__kpi--accent">
                    <dt>Record</dt>
                    <dd>{{ trajectory.best.weightKg|round|number_format(0, ',', ' ') }}<span class="kd-wk__unit"> kg</span></dd>
                    <p class="kd-wk__kpimeta">
                        {{ trajectory.best.detail }} ·
                        <a href="{{ path('app_scheduled_workout_show', {id: trajectory.best.scheduledWorkoutId}) }}">{{ trajectory.best.date|date('d/m/Y') }}</a>
                    </p>
                </div>
            {% endif %}

            <div class="kd-wk__kpi">
                <dt>Dernière fois</dt>
                <dd>{{ trajectory.last.workingSets }}<span class="kd-wk__unit"> série{{ trajectory.last.workingSets > 1 ? 's' }}</span></dd>
                <p class="kd-wk__kpimeta">
                    {{ trajectory.last.date|date('d/m/Y') }}
                    {%- if trajectory.last.topWeightKg is not null %} · top {{ trajectory.last.topWeightKg|round|number_format(0, ',', ' ') }} kg{% endif %}
                </p>
            </div>

            <div class="kd-wk__kpi">
                <dt>Séances</dt>
                <dd>{{ trajectory.sessions|length }}</dd>
                <p class="kd-wk__kpimeta">dernières séances où il apparaît</p>
            </div>
        </dl>

        {# Les courbes sur une fenêtre choisie (plan, 6 mois, 1 an, tout). Elles
           prennent la place de l'ancienne courbe des dix dernières séances : la
           liste ci-dessous dit déjà ces dix-là, mieux qu'un dessin. #}
        {% if progress %}
            {{ include('components/_exercise_progress.html.twig', {
                exercise: exercise, progress: progress, subject: subject
            }, with_context = false) }}
        {% endif %}

        <div class="kd-extraj__part">
            <h3 class="kd-prog__subtitle">Les dernières séances</h3>
            <ul class="kd-extraj__list">
                {% for session in trajectory.sessions %}
                    <li class="kd-extraj__item">
                        <a href="{{ path('app_scheduled_workout_show', {id: session.scheduledWorkoutId}) }}"
                           class="kd-extraj__date">{{ session.date|date('d/m/Y') }}</a>
                        <span class="kd-extraj__sets">
                            {% for group in session.sets %}
                                <span class="kd-extraj__group">
                                    {{ settype.badge(group.type) }}{{ group.count }} × {{ group.detail }}
                                </span>
                            {% endfor %}
                        </span>
                        {% if session.tonnageKg > 0 %}
                            <span class="kd-extraj__vol">{{ session.tonnageKg|round|number_format(0, ',', ' ') }} kg</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}
