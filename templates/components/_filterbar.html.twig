{# ============================================================================
   Barre d'outils des index filtrables (bibliothèque, séances, plans).
   Pilotée par le contrôleur Stimulus `filter` (recherche pondérée + facettes +
   tri, 100 % client / offline-safe). À placer DANS un `data-controller="filter"`,
   au-dessus du conteneur `data-filter-target="list"`.

   Paramètres :
     - placeholder : texte du champ de recherche
     - total       : effectif initial (compteur)
     - countNoun   : nom au singulier ("exercice", "séance", "plan")
     - sortOptions : list de { key, label, dir?('asc'|'desc'), numeric?(bool) }
     - facetGroups : list de { group, allLabel, facets:[{value,label,count}],
                               default?(valeur active au chargement, 'all' sinon) }

   `default` sert au groupe « propriétaire » d'un coach : la page s'ouvre sur ses
   propres entrées, les athlètes sont à une puce. Le contrôleur Stimulus lit cet
   état initial dans les classes rendues — ne pas activer une puce à la main sans
   passer par `default`, la logique de filtre ne la verrait pas.

   `<details>` natif : sur téléphone, recherche + tri + deux rangées de puces
   mangeaient un écran entier avant la première carte. Rendu **ouvert** côté
   serveur (sans JS rien n'est caché), le contrôleur `collapse` le referme sous
   560px. Au-dessus, le `<summary>` est masqué en CSS et le panneau reste ouvert.
   ============================================================================ #}
<details class="kd-filterbar" open
         data-controller="collapse" data-collapse-media-value="(max-width: 560px)">
    <summary class="kd-filterbar__toggle">
        {{ ux_icon('lucide:sliders-horizontal') }}
        <span>Filtres et tri</span>
        {{ ux_icon('lucide:chevron-down') }}
    </summary>

    <div class="kd-filterbar__row">
        <div class="kd-search">
            {{ ux_icon('lucide:search') }}
            <input type="search" class="kd-input" placeholder="{{ placeholder }}"
                   aria-label="{{ placeholder }}"
                   data-filter-target="input" data-action="input->filter#search">
        </div>

        {% if sortOptions is defined and sortOptions %}
            <label class="kd-sort">
                {{ ux_icon('lucide:arrow-up-down') }}
                <select class="kd-input kd-sort__select" aria-label="Trier"
                        data-filter-target="sort" data-action="change->filter#sort">
                    {% for opt in sortOptions %}
                        <option value="{{ opt.key }}"
                                {%- if opt.dir is defined %} data-dir="{{ opt.dir }}"{% endif %}
                                {%- if opt.numeric is defined and opt.numeric %} data-numeric="1"{% endif %}>{{ opt.label }}</option>
                    {% endfor %}
                </select>
            </label>
        {% endif %}

        <span class="kd-count"><span data-filter-target="count">{{ total }}</span> {{ countNoun }}{{ total > 1 ? 's' }}</span>
    </div>

    {% for grp in facetGroups|default([]) %}
        {% if grp.facets %}
            {% set active = grp.default|default('all') %}
            <div class="kd-libfilters">
                <button type="button" class="kd-libfilter{{ active == 'all' ? ' kd-libfilter--on' }}"
                        data-filter-target="facet" data-facet-group="{{ grp.group }}" data-facet-value="all"
                        data-action="filter#pickFacet">{{ grp.allLabel }} · {{ total }}</button>
                {% for f in grp.facets %}
                    <button type="button" class="kd-libfilter{{ active == f.value ? ' kd-libfilter--on' }}"
                            data-filter-target="facet" data-facet-group="{{ grp.group }}" data-facet-value="{{ f.value }}"
                            data-action="filter#pickFacet">{{ f.label }} · {{ f.count }}</button>
                {% endfor %}
            </div>
        {% endif %}
    {% endfor %}
</details>
