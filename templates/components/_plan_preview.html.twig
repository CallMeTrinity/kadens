{# Aperçu au survol d'une séance placée : promu en top-layer (Popover API) pour
   échapper à l'overflow de la grille. Auto-suffisant (aucun AJAX). Positionné en
   JS par le contrôleur porteur (`plangrid` en édition, `preview` en lecture).

   Attend `fw` = sortie de PlanFlattener::flattenWorkout (workout + blocks).

   Séries détaillées : même rendu que la vue séance (une ligne par groupe de
   séries, pastille de type en tête), pas le résumé compact d'une seule chaîne —
   il devenait illisible dès qu'une prescription mélangeait plusieurs types. #}
{% import 'components/_set_type.html.twig' as settype %}
<div class="kd-planpreview" popover="manual" data-preview-target="panel">
    <p class="kd-planpreview__title">{{ fw.workout.title }}</p>
    {% if fw.blocks is empty %}
        <p class="kd-planpreview__empty">Séance vide.</p>
    {% else %}
        {% for b in fw.blocks %}
            <div class="kd-planpreview__block">
                <p class="kd-planpreview__blockname">
                    {{ b.block.label ?: b.block.role.label }}{% if b.block.rounds > 1 %} · ×{{ b.block.rounds }}{% endif %}
                </p>
                <ul class="kd-planpreview__exos">
                    {% for ex in b.exercises %}
                        <li{% if ex.sets %} class="kd-planpreview__exo--detailed"{% endif %}>
                            {% if ex.groupLabel %}<span class="kd-planpreview__rank">{{ ex.groupLabel }}</span>{% endif %}
                            <span class="kd-planpreview__exoname">{{ exercise_name(ex.exercise) }}</span>
                            {% if ex.sets %}
                                <ul class="kd-setlist kd-setlist--preview">
                                    {% for g in ex.sets %}
                                        <li class="kd-setline kd-setline--{{ g.type.value }}">
                                            {{ settype.slot(g.type) }}
                                            <span class="kd-setline__count">{% if g.count > 1 %}{{ g.count }}×{% endif %}</span>
                                            <span class="kd-setline__detail">{{ g.detail }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% elseif ex.summary %}
                                <span class="kd-planpreview__sum">{{ ex.summary }}</span>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="kd-planpreview__empty">—</li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    {% endif %}
</div>
