{# ---------------------------------------------------------------------------
   Métadonnées PWA — installabilité, icônes, écrans de démarrage.

   Chemins EN DUR sous /pwa/ et non via asset() : ces fichiers sont servis tels
   quels depuis public/, hors AssetMapper, pour que leurs URL restent stables
   (le manifest et le service worker y font référence par chemin absolu).

   Pourquoi /pwa et pas /icons : Apache déclare par défaut un `Alias /icons/`
   vers ses propres icônes d'autoindex. Sur mutualisé Infomaniak on ne peut pas
   le retirer, donc tout fichier de public/icons/ est inatteignable en prod.

   Régénérer les visuels : php tools/build-pwa-icons.php
   --------------------------------------------------------------------------- #}

<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#0b0b0b">

{# Favicons — 3 tailles, le navigateur choisit. #}
<link rel="icon" href="/pwa/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/pwa/favicon-16.png" sizes="16x16" type="image/png">
<link rel="icon" href="/pwa/favicon-48.png" sizes="48x48" type="image/png">

{# iOS — pas de manifest pour l'icône d'écran d'accueil, il faut ce lien. #}
<link rel="apple-touch-icon" href="/pwa/apple-touch-icon.png" sizes="180x180">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Kadens">
{# `black-translucent` fait passer le contenu sous la barre d'état ; le header
   collant est déjà encre, mais la nav basse gère ses safe areas via
   --kd-navbar-h. On reste donc sur `default` pour ne rien décaler. #}
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="application-name" content="Kadens">

