{# Panneau « Programme » : les blocs d'une séance, en accordéon.

   Un <details open> natif plutôt qu'un contrôleur Stimulus : on gagne
   gratuitement le clavier, l'état sans JS et l'ouverture forcée à l'impression.

   Attendus : blocks (flat.blocks), statsByIndex (WorkoutMetrics::blockBreakdown
   indexé par position, optionnel), logs (réalisé indexé par exercice puis rang,
   optionnel — seule la fiche datée en fournit). #}
{% set logs = logs|default({}) %}
{% import 'components/_set_type.html.twig' as settype %}

{% set role_icon = {'warmup': 'lucide:flame', 'main': 'lucide:activity', 'cooldown': 'lucide:wind'} %}

<ol class="kd-blocks">
    {% for entry in blocks %}
        {% set block = entry.block %}
        {% set stat = statsByIndex[loop.index0]|default(null) %}
        <li class="kd-block">
            <details class="kd-block__wrap" open>
                <summary class="kd-block__head">
                    <span class="kd-block__num">{{ '%02d'|format(loop.index) }}</span>

                    <span class="kd-block__role">
                        {{ ux_icon(role_icon[block.role.value] ?? 'lucide:activity') }}
                        {{ block.role.label }}
                    </span>

                    {% if block.label %}<span class="kd-block__label">{{ block.label }}</span>{% endif %}

                    {# Les enchaînements se nomment au groupe, dans la liste : un
                       bloc peut n'en porter aucun, ou plusieurs. L'en-tête ne
                       garde que ce qui est vrai du bloc entier. #}
                    {% if block.rounds > 1 %}<span class="kd-block__rounds">× {{ block.rounds }} tours</span>{% endif %}

                    <span class="kd-block__sum">
                        {%- if stat and stat.seconds > 0 %}≈ {{ (stat.seconds / 60)|round(0, 'ceil') }} min{% endif -%}
                        {%- if stat and stat.tonnageKg > 0 %} · {{ stat.tonnageKg|round|number_format(0, ',', ' ') }} kg{% endif -%}
                        {%- if entry.exercises|length %} · {{ entry.exercises|length }} exercice{{ entry.exercises|length > 1 ? 's' }}{% endif -%}
                    </span>

                    <span class="kd-block__chevron" aria-hidden="true">{{ ux_icon('lucide:chevron-down') }}</span>
                </summary>

                {% if entry.exercises is empty %}
                    <p class="kd-exrow--empty">Aucun exercice.</p>
                {% else %}
                    {# Segment par segment : un exercice isolé, ou un groupe lié
                       (superset / circuit) qui s'enchaîne sans repos. Le groupe
                       est un sous-ensemble du bloc, pas le bloc entier. #}
                    <ol class="kd-exlist">
                        {% for segment in entry.segments %}
                            {% if segment.label %}
                                <li class="kd-exgroup">
                                    <p class="kd-exgroup__head">
                                        {{ ux_icon('lucide:link') }}
                                        {{ segment.kind == 'circuit' ? 'Circuit' : 'Superset' }} {{ segment.label }}
                                        <span class="kd-exgroup__hint">enchaîné sans repos</span>
                                    </p>
                                    <ol class="kd-exlist kd-exlist--nested">
                                        {% for ex in segment.exercises %}
                                            {% include 'components/_workout_exrow.html.twig' with {
                                                ex: ex, logs: logs
                                            } only %}
                                        {% endfor %}
                                    </ol>
                                </li>
                            {% else %}
                                {% for ex in segment.exercises %}
                                    {% include 'components/_workout_exrow.html.twig' with {
                                        ex: ex, logs: logs
                                    } only %}
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </ol>
                {% endif %}
            </details>
        </li>
    {% endfor %}
</ol>
