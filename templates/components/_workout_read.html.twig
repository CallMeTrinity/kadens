{# Rendu lecture seule d'une séance mise à plat par PlanFlattener.
   Partagé par la vue propriétaire (workout/show) et la vue publique
   (public_share/workout). Auto-suffisant : aucun AJAX post-rendu, condition
   du cache offline.

   Attendus :
     flat        sortie de PlanFlattener::flattenWorkout   (requis)
     summary     sortie de WorkoutMetrics::summary         (optionnel)
     blockStats  sortie de WorkoutMetrics::blockBreakdown  (optionnel)

   Les métriques sont optionnelles : sans elles, la page reste valide et rend
   le seul programme. C'est ce qui permet de réutiliser ce composant partout
   sans obliger chaque appelant à instancier WorkoutMetrics.

   Le bloc `actions` accueille la barre d'actions du propriétaire, posée dans le
   hero. La page publique l'ignore et n'affiche donc rien — d'où un `embed`
   côté workout/show plutôt qu'un `include` (un include ne porte pas de blocs). #}
{% import 'components/_activity.html.twig' as activity %}
{% set workout = flat.workout %}
{% set summary = summary|default(null) %}
{% set blockStats = blockStats|default([]) %}

{# Statistiques indexées par position de bloc, pour retrouver celles d'un bloc
   pendant la boucle de rendu (les deux listes suivent le même ordre). #}
{% set statsByIndex = {} %}
{% for i, stat in blockStats %}
    {% set statsByIndex = statsByIndex|merge({ (i): stat }) %}
{% endfor %}

<article class="kd-wk">

    {# ---------------------------------------------------------------- Hero #}
    <header class="kd-wk__hero">
        <div class="kd-wk__heroinner">
            {% block actions %}{% endblock %}

            <div class="kd-wk__herobody">
                <div class="kd-wk__herotitle">
                    <p class="kd-wk__eyebrow">Séance</p>
                    <h1 class="kd-wk__title">{{ workout.title }}</h1>
                    {% if workout.description %}
                        <p class="kd-wk__desc">{{ workout.description|nl2br }}</p>
                    {% endif %}
                </div>

                <dl class="kd-wk__herostats">
                    {% if workout.estimatedDurationMinutes %}
                        <div class="kd-wk__herostat">
                            <dt>Durée</dt>
                            <dd>{{ workout.estimatedDurationMinutes }}<span class="kd-wk__unit"> min</span></dd>
                        </div>
                    {% endif %}
                    <div class="kd-wk__herostat">
                        <dt>Blocs</dt>
                        <dd>{{ flat.blocks|length }}</dd>
                    </div>
                    <div class="kd-wk__herostat">
                        <dt>Exercices</dt>
                        <dd>{{ flat.exerciseCount }}</dd>
                    </div>
                </dl>
            </div>

            {% if flat.activities is not empty %}
                <ul class="kd-wk__heroacts">
                    {% for act in flat.activities %}
                        <li>{{ activity.badge(act) }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </header>

    {% if flat.blocks is empty %}
        <div class="kd-card kd-empty">
            {{ ux_icon('lucide:clipboard-list') }}
            <div>Cette séance est encore vide.</div>
        </div>
    {% else %}

        {# ------------------------------------------------------- Bandeau KPI #}
        {% if summary and summary.workingSets > 0 %}
            <dl class="kd-wk__kpis">
                <div class="kd-wk__kpi">
                    <dt>Volume total</dt>
                    <dd>{{ summary.tonnageKg|round|number_format(0, ',', ' ') }}<span class="kd-wk__unit"> kg</span></dd>
                    <p class="kd-wk__kpimeta">{{ summary.workingSets }} série{{ summary.workingSets > 1 ? 's' }} de travail</p>
                </div>

                <div class="kd-wk__kpi">
                    <dt>Enchaînements</dt>
                    <dd>{{ summary.supersets + summary.circuits }}</dd>
                    <p class="kd-wk__kpimeta">
                        {%- if summary.supersets %}{{ summary.supersets }} superset{{ summary.supersets > 1 ? 's' }}{% endif -%}
                        {%- if summary.supersets and summary.circuits %} · {% endif -%}
                        {%- if summary.circuits %}{{ summary.circuits }} circuit{{ summary.circuits > 1 ? 's' }}{% endif -%}
                        {%- if not summary.supersets and not summary.circuits %}Séance à plat{% endif -%}
                    </p>
                </div>

                {% if summary.averageRpe is not null %}
                    <div class="kd-wk__kpi kd-wk__kpi--accent">
                        <dt>Intensité moyenne</dt>
                        <dd>RPE {{ summary.averageRpe|number_format(1, ',', ' ') }}</dd>
                        {# Jauge de 10 crans : le RPE se lit sur 1..10, une jauge
                           à cette échelle évite toute conversion mentale. #}
                        <p class="kd-wk__gauge" role="img"
                           aria-label="RPE moyen {{ summary.averageRpe|number_format(1, ',', ' ') }} sur 10">
                            {% for i in 1..10 %}
                                <span class="kd-wk__gaugetick{{ i <= summary.averageRpe|round ? ' is-on' }}"></span>
                            {% endfor %}
                        </p>
                    </div>
                {% endif %}

                {% if summary.topLift %}
                    <div class="kd-wk__kpi">
                        <dt>Charge la plus lourde</dt>
                        <dd>{{ summary.topLift.weightKg|round|number_format(0, ',', ' ') }}<span class="kd-wk__unit"> kg</span></dd>
                        <p class="kd-wk__kpimeta">{{ summary.topLift.exercise }}</p>
                    </div>
                {% endif %}
            </dl>
        {% endif %}

        {# ------------------------------------------------------------ Onglets
           Sans JS, les deux panneaux s'affichent à la suite avec leur titre :
           la page reste complète et imprimable. Le contrôleur `tabs` ne fait que
           masquer l'un des deux et poser la sémantique ARIA. #}
        {% set has_analysis = summary and summary.workingSets > 0 %}
        <div class="kd-wk__tabs" data-controller="tabs">
            {% if has_analysis %}
                <div class="kd-wk__tablist" data-tabs-target="list" hidden>
                    <button type="button" class="kd-wk__tab" data-tabs-target="tab" data-tabs-panel-param="programme">
                        {{ ux_icon('lucide:list') }} Programme
                    </button>
                    <button type="button" class="kd-wk__tab" data-tabs-target="tab" data-tabs-panel-param="analyse">
                        {{ ux_icon('lucide:chart-column') }} Analyse
                    </button>
                </div>
            {% endif %}

            <section class="kd-wk__panel" data-tabs-target="panel" data-tabs-name="programme"
                     aria-labelledby="wk-panel-programme">
                <h2 class="kd-wk__paneltitle" id="wk-panel-programme" data-tabs-target="panelTitle">Programme</h2>
                {% include 'components/_workout_program.html.twig' with {
                    blocks: flat.blocks, statsByIndex: statsByIndex
                } only %}
            </section>

            {% if has_analysis %}
                <section class="kd-wk__panel" data-tabs-target="panel" data-tabs-name="analyse"
                         aria-labelledby="wk-panel-analyse">
                    <h2 class="kd-wk__paneltitle" id="wk-panel-analyse" data-tabs-target="panelTitle">Analyse</h2>
                    {% include 'components/_workout_analysis.html.twig' with {
                        summary: summary, blockStats: blockStats
                    } only %}
                </section>
            {% endif %}
        </div>
    {% endif %}
</article>
