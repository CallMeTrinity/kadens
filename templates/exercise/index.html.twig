{% extends 'base.html.twig' %}
{% import 'components/_activity.html.twig' as activity %}

{% block title %}Bibliothèque d'exercices{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}

    <div class="kd-pagehead">
        <div>
            <p class="kd-eyebrow">Bibliothèque</p>
            <h1 class="kd-title">Exercices</h1>
            <p class="kd-lead">Tes mouvements, perso et globaux. La brique de base des séances.</p>
        </div>
        <a href="{{ path('app_exercise_new') }}" class="kd-btn kd-btn--primary">
            {{ ux_icon('lucide:plus') }} Nouvel exercice
        </a>
    </div>

    <div data-controller="filter">
        {% set persoCount = exercises|filter(e => e.owner is not null)|length %}
        {% set globalCount = exercises|filter(e => e.owner is null)|length %}

        {# KL-51 — sentinelle de tri : « pas fait depuis » est CROISSANT (le plus
           ancien d'abord), un exercice jamais fait n'a donc pas sa place en tête,
           il y ferait doublon avec le tri « jamais faits ». On le renvoie tout en
           bas avec une date impossible. #}
        {% set neverSort = 9999999999 %}

        {# Les trois tris d'usage ne s'exposent que s'il y a un usage à trier :
           sur une base sans réalisé, ils ne feraient rien et le diraient mal. #}
        {% set usageSorts = usage is empty ? [] : [
            { key: 'usage', label: 'Les plus faits', dir: 'desc', numeric: true },
            { key: 'usage', label: 'Jamais faits', dir: 'asc', numeric: true },
            { key: 'last', label: 'Pas fait depuis', dir: 'asc', numeric: true },
        ] %}

        {{ include('components/_filterbar.html.twig', {
            placeholder: 'Rechercher un exercice…',
            total: exercises|length,
            countNoun: 'exercice',
            sortOptions: [
                { key: 'name', label: 'Nom (A→Z)', dir: 'asc' },
                { key: 'name', label: 'Nom (Z→A)', dir: 'desc' },
                { key: 'created', label: 'Plus récent', dir: 'desc', numeric: true },
            ]|merge(usageSorts),
            facetGroups: [
                { group: 'activity', allLabel: 'Toutes activités', facets: activityFacets },
                { group: 'scope', allLabel: 'Toutes portées', facets: [
                    { value: 'perso', label: 'Perso', count: persoCount },
                    { value: 'global', label: 'Bibliothèque', count: globalCount },
                ]|filter(f => f.count > 0) },
            ],
        }) }}

        {% if exercises is empty %}
            <div class="kd-card kd-empty">
                {{ ux_icon('lucide:dumbbell') }}
                <div>Aucun exercice pour l'instant.</div>
                <a href="{{ path('app_exercise_new') }}" class="kd-btn kd-btn--secondary kd-btn--sm" style="margin-top:var(--kd-space-6);">
                    {{ ux_icon('lucide:plus') }} Créer le premier
                </a>
            </div>
        {% else %}
            <div class="kd-grid kd-grid--3" data-filter-target="list">
                {% for exercise in exercises %}
                    {% set mod = activity.modifier(exercise.activity)|trim %}
                    {% set used = usage[exercise.id]|default(null) %}
                    <article class="kd-libcard{{ mod ? ' kd-libcard--' ~ mod }}"
                             data-filter-target="item"
                             data-filter-name="{{ exercise.name }}"
                             data-filter-text="{{ exercise.name }} {{ exercise.activity.label }} {% for area in exercise.targetAreas %}{{ area.label }} {% endfor %}"
                             data-facet-activity="{{ exercise.activity.value }}"
                             data-facet-scope="{{ exercise.owner is null ? 'global' : 'perso' }}"
                             data-sort-name="{{ exercise.name|lower }}"
                             data-sort-created="{{ exercise.createdAt ? exercise.createdAt|date('U') : 0 }}"
                             data-sort-usage="{{ used ? used.count : 0 }}"
                             data-sort-last="{{ used and used.lastAt ? used.lastAt|date('U') : neverSort }}">
                        <div class="kd-libcard__head">
                            <span class="kd-libcard__icon">{{ ux_icon(activity.icon(exercise.activity)|trim) }}</span>
                            <div class="kd-libcard__body">
                                {% if is_granted('VIEW', exercise) %}
                                    <a class="kd-libcard__name" href="{{ path('app_exercise_show', {id: exercise.id}) }}">{{ exercise.name }}</a>
                                {% else %}
                                    <span class="kd-libcard__name">{{ exercise.name }}</span>
                                {% endif %}
                                <div class="kd-libcard__meta">
                                    {{ exercise.activity.label }}
                                    <span class="kd-scope">
                                        {% if exercise.owner is null %}
                                            {{ ux_icon('lucide:library') }} Bibliothèque
                                        {% else %}
                                            {{ ux_icon('lucide:user') }} Perso
                                        {% endif %}
                                    </span>
                                    {# Usage réel, discret : le compte de MES séances, pas de tout le monde. #}
                                    {% if used %}
                                        <span class="kd-libcard__usage"
                                              title="Fait {{ used.count }} fois{% if used.lastAt %}, la dernière le {{ used.lastAt|date('d/m/Y') }}{% endif %}">
                                            {{ ux_icon('lucide:history') }} {{ used.count }}×
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {% if exercise.targetAreas is not empty %}
                            <div class="kd-tags">
                                {% for area in exercise.targetAreas %}
                                    <span class="kd-tag">{{ area.label }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="kd-libcard__foot">
                            {% if is_granted('VIEW', exercise) %}
                                <a href="{{ path('app_exercise_show', {id: exercise.id}) }}" class="kd-btn kd-btn--ghost kd-btn--sm">
                                    {{ ux_icon('lucide:arrow-right') }} Voir
                                </a>
                            {% endif %}
                            {% if is_granted('EDIT', exercise) %}
                                <a href="{{ path('app_exercise_edit', {id: exercise.id}) }}" class="kd-btn kd-btn--ghost kd-btn--sm kd-libcard__foot-sep">
                                    {{ ux_icon('lucide:square-pen') }} Éditer
                                </a>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="kd-card kd-empty" data-filter-target="empty" hidden>
                {{ ux_icon('lucide:search') }}
                <div>Aucun exercice ne correspond à ta recherche.</div>
            </div>
        {% endif %}
    </div>
{% endblock %}
