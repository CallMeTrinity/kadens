{# Contenu de #plan-grid : trame éditable semaines × 7 jours. Chaque mutation
   (poser/retirer/déplacer/dupliquer) met à jour le CONTENU de ce conteneur via
   Turbo Stream (action="update", l'id survit). Contexte attendu (fourni par
   gridContext) : template, flat (sortie de PlanFlattener::flattenPlanTemplate).

   Chaque case porte sa PROPRE copie de séance (fork à la pose) : l'éditer via la
   modale ne touche ni la séance de bibliothèque ni les autres cases.

   Deux zones et un geste, comme le compositeur de séance :
   1. la carte de séance entière ouvre l'édition rapide, et c'est aussi la prise du
      glisser-déposer (appui long au doigt, cf. le contrôleur `plangrid`) — il n'y
      a plus de poignée de 13px, intenable au doigt ;
   2. tout le reste (édition complète, déplacer, retirer) vit dans un menu kebab, en
      toutes lettres. Même chose pour l'en-tête de semaine.
   L'ajout se fait par le « + » du jour, qui désigne du même geste la case visée. #}
{% import 'components/_activity.html.twig' as activity %}
{% set dayNames = {1: 'Lun', 2: 'Mar', 3: 'Mer', 4: 'Jeu', 5: 'Ven', 6: 'Sam', 7: 'Dim'} %}
{% set dayFull = {1: 'lundi', 2: 'mardi', 3: 'mercredi', 4: 'jeudi', 5: 'vendredi', 6: 'samedi', 7: 'dimanche'} %}

<div class="kd-planweeks">
    {% for week in flat.weeks %}
        <section class="kd-planweek">
            <div class="kd-planweek__head">
                <span class="kd-planweek__num">Semaine {{ week.weekNumber }}</span>
                {% if template.durationWeeks > 1 %}
                    {# Actions de semaine en menu, pas en rangée : le select « copier
                       vers » et deux boutons ne tiennent pas sur une ligne de téléphone. #}
                    <details class="kd-kebab kd-kebab--row kd-planweek__menu" data-controller="dismiss">
                        <summary class="kd-kebab__trigger kd-kebab__trigger--plain" aria-label="Actions sur la semaine {{ week.weekNumber }}">
                            {{ ux_icon('lucide:ellipsis') }}
                        </summary>
                        <div class="kd-kebab__panel">
                            {# Copier cette semaine vers une cible libre (remplace la cible). #}
                            <form method="post" class="kd-kebab__form"
                                  action="{{ path('app_plan_template_week_copy', {id: template.id, week: week.weekNumber}) }}"
                                  onsubmit="return confirm('Copier la semaine {{ week.weekNumber }} vers la semaine choisie ? Son contenu actuel sera remplacé.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('week_copy' ~ week.weekNumber) }}">
                                <label class="kd-kebab__formlabel" for="week-copy-{{ week.weekNumber }}">
                                    {{ ux_icon('lucide:copy') }} Copier vers
                                </label>
                                <div class="kd-kebab__formrow">
                                    <select name="target" id="week-copy-{{ week.weekNumber }}" class="kd-input"
                                            aria-label="Semaine de destination">
                                        {% for w in 1..template.durationWeeks %}
                                            {% if w != week.weekNumber %}<option value="{{ w }}">Semaine {{ w }}</option>{% endif %}
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="kd-btn kd-btn--secondary kd-btn--sm">Copier</button>
                                </div>
                            </form>

                            {{ include('components/_menu_form.html.twig', {
                                action: path('app_plan_template_week_remove', {id: template.id, week: week.weekNumber}),
                                token: csrf_token('week_remove' ~ week.weekNumber),
                                icon: 'lucide:trash-2',
                                variant: 'danger',
                                label: 'Retirer la semaine',
                                confirm: 'Retirer la semaine ' ~ week.weekNumber ~ ' ? Les séances encore prévues au calendrier seront retirées (le réalisé est conservé).'
                            }) }}
                        </div>
                    </details>
                {% endif %}
            </div>

            {# Charge de la semaine, ventilée par activité (salle : séries par groupe
               musculaire + tonnage ; endurance : distance/durée). Source : PlanVolumeAggregator. #}
            {% set vol = weekVolumes[week.weekNumber] ?? null %}
            {% if vol and vol.sessions > 0 %}
                <div class="kd-weekvol">
                    <span class="kd-weekvol__sessions">
                        {{ vol.sessions }} séance{{ vol.sessions > 1 ? 's' }} · ~{{ vol.totalTime }}
                    </span>
                    {% for chip in vol.chips %}
                        {% set mod = activity.modifier(chip.activity) %}
                        <span class="kd-weekvol__chip{{ mod ? ' kd-weekvol__chip--' ~ mod }}">
                            {{ ux_icon(activity.icon(chip.activity)|trim) }} {{ chip.label }} · {{ chip.value }}
                        </span>
                    {% endfor %}
                    {% if vol.gymAreas is not empty %}
                        <details class="kd-weekvol__detail">
                            <summary>Séries par groupe</summary>
                            <ul class="kd-weekvol__areas">
                                {% for a in vol.gymAreas %}
                                    <li>{{ a.label }}<span>{{ a.sets }}</span></li>
                                {% endfor %}
                            </ul>
                            {% if vol.tonnage %}<p class="kd-weekvol__tonnage">Tonnage salle : {{ vol.tonnage }}</p>{% endif %}
                        </details>
                    {% endif %}
                </div>
            {% endif %}

            <div class="kd-plangrid kd-plangrid--edit">
                {% for day in week.days %}
                    <div class="kd-planday{{ day.items is empty ? ' is-empty' }}">
                        <div class="kd-planday__name">{{ dayNames[day.dayOfWeek] }}</div>
                        <div class="kd-planday__body">
                            {# Zone de dépôt SortableJS : source ET cible, la semaine/jour
                               cible sont portées ici et lues à la pose. #}
                            <div class="kd-planday__items" data-plangrid-target="cell"
                                 data-week="{{ week.weekNumber }}" data-day="{{ day.dayOfWeek }}"
                                 data-action="click->plangrid#stampCell">
                                {% for entry in day.items %}
                                    <div class="kd-planentry" data-item-id="{{ entry.item.id }}"
                                         data-move-url="{{ path('app_plan_template_item_move', {id: template.id, itemId: entry.item.id}) }}"
                                         data-move-token="{{ csrf_token('item_move' ~ entry.item.id) }}"
                                         data-action="mouseenter->plangrid#showPreview mouseleave->plangrid#hidePreview">
                                        <div class="kd-planitem">
                                            <button type="button" class="kd-planitem__link"
                                                    data-action="plangrid#edit"
                                                    data-panel-url="{{ path('app_workout_quick_panel', {id: entry.item.workout.id}) }}"
                                                    data-full-url="{{ path('app_workout_edit', {id: entry.item.workout.id}) }}">
                                                <span class="kd-planitem__title">{{ entry.workout.workout.title }}</span>
                                                <span class="kd-planitem__meta">
                                                    {% if entry.item.workout.estimatedDurationMinutes %}
                                                        <span>{{ ux_icon('lucide:clock') }} {{ entry.item.workout.estimatedDurationMinutes }} min</span>
                                                    {% endif %}
                                                    {% if entry.workout.exerciseCount %}
                                                        <span>{{ entry.workout.exerciseCount }} exo{{ entry.workout.exerciseCount > 1 ? 's' }}</span>
                                                    {% endif %}
                                                </span>
                                                {% if entry.workout.activities %}
                                                    <span class="kd-cellbadges">
                                                        {% for a in entry.workout.activities %}{{ activity.badge(a, false) }}{% endfor %}
                                                    </span>
                                                {% endif %}
                                            </button>

                                            <details class="kd-kebab kd-kebab--row" data-controller="dismiss">
                                                <summary class="kd-kebab__trigger kd-kebab__trigger--plain"
                                                         aria-label="Actions sur {{ entry.workout.workout.title }}">
                                                    {{ ux_icon('lucide:ellipsis') }}
                                                </summary>
                                                <div class="kd-kebab__panel">
                                                    <a class="kd-kebab__item" href="{{ path('app_workout_edit', {id: entry.item.workout.id}) }}">
                                                        {{ ux_icon('lucide:square-pen') }} Édition complète
                                                    </a>

                                                    {# Repli du glisser-déposer : indispensable au clavier, et plus
                                                       sûr que l'appui long quand la trame est longue. Sans JS, ce
                                                       POST redirige simplement vers l'éditeur. #}
                                                    <form method="post" class="kd-kebab__form"
                                                          action="{{ path('app_plan_template_item_move', {id: template.id, itemId: entry.item.id}) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('item_move' ~ entry.item.id) }}">
                                                        <span class="kd-kebab__formlabel">
                                                            {{ ux_icon('lucide:move') }} Déplacer vers
                                                        </span>
                                                        <div class="kd-kebab__formrow">
                                                            <select name="week" class="kd-input" aria-label="Semaine de destination">
                                                                {% for w in 1..template.durationWeeks %}
                                                                    <option value="{{ w }}"{{ w == week.weekNumber ? ' selected' }}>S{{ w }}</option>
                                                                {% endfor %}
                                                            </select>
                                                            <select name="day" class="kd-input" aria-label="Jour de destination">
                                                                {% for d, name in dayNames %}
                                                                    <option value="{{ d }}"{{ d == day.dayOfWeek ? ' selected' }}>{{ name }}</option>
                                                                {% endfor %}
                                                            </select>
                                                            <button type="submit" class="kd-btn kd-btn--secondary kd-btn--sm">OK</button>
                                                        </div>
                                                    </form>

                                                    {{ include('components/_menu_form.html.twig', {
                                                        action: path('app_plan_template_item_delete', {id: template.id, itemId: entry.item.id}),
                                                        token: csrf_token('item_delete' ~ entry.item.id),
                                                        icon: 'lucide:x',
                                                        variant: 'danger',
                                                        label: 'Retirer de la trame',
                                                        confirm: 'Retirer cette séance de la trame ?'
                                                    }) }}
                                                </div>
                                            </details>
                                        </div>
                                        {# Note de case éditable en ligne (clic). Toujours présente : une note
                                           vide devient un discret « + note ». #}
                                        <p class="kd-planday__notes kd-inlineedit kd-inlineedit--note{{ entry.item.notes ? '' : ' kd-inlineedit--empty' }}"
                                           data-controller="inline-edit"
                                           data-inline-edit-url-value="{{ path('app_plan_template_item_note', {id: template.id, itemId: entry.item.id}) }}"
                                           data-inline-edit-token-value="{{ csrf_token('item_note' ~ entry.item.id) }}"
                                           data-inline-edit-field-value="notes"
                                           data-inline-edit-type-value="textarea"
                                           data-inline-edit-placeholder-value="+ note"
                                           data-inline-edit-target="display"
                                           data-value="{{ entry.item.notes }}"
                                           data-action="click->inline-edit#start">{{ entry.item.notes ?: '+ note' }}</p>

                                        {# Aperçu au survol (top-layer via Popover API), positionné par le
                                           contrôleur plangrid pour échapper à l'overflow de la grille. #}
                                        {{ include('components/_plan_preview.html.twig', {fw: entry.workout}) }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        {# Chemin d'ajout attaché au jour, HORS du conteneur trié (SortableJS
                           calcule ses index sur les enfants directs de la cellule). Il ouvre
                           la palette SUR cette case : sous 900px en feuille, au-dessus en
                           donnant le focus à la recherche. Le glisser-déposer et le mode
                           tampon restent des raccourcis de souris, jamais le seul chemin. #}
                        <button type="button" class="kd-planday__add"
                                data-action="plangrid#openLib"
                                data-week="{{ week.weekNumber }}" data-day="{{ day.dayOfWeek }}"
                                data-cell-label="S{{ week.weekNumber }} · {{ dayFull[day.dayOfWeek] }}"
                                aria-label="Ajouter une séance — semaine {{ week.weekNumber }}, {{ dayFull[day.dayOfWeek] }}">
                            {{ ux_icon('lucide:plus') }}
                        </button>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endfor %}

    {# La durée du plan n'est plus un nombre qu'on saisit : elle se construit
       semaine par semaine. Le champ « + N » est là pour ne pas cliquer douze fois
       quand on connaît déjà la longueur du bloc. Deux formulaires distincts (même
       intention CSRF) : le bouton « +1 » ne doit pas être bloqué par la validation
       HTML5 du champ nombre. #}
    {% set remaining = 52 - template.durationWeeks %}
    <div class="kd-planweek__add">
        {% if remaining > 0 %}
            <form method="post" action="{{ path('app_plan_template_week_add', {id: template.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('week_add' ~ template.id) }}">
                <button type="submit" class="kd-btn kd-btn--secondary kd-btn--sm">
                    {{ ux_icon('lucide:calendar-plus') }} Ajouter une semaine
                </button>
            </form>

            <form method="post" action="{{ path('app_plan_template_week_add', {id: template.id}) }}"
                  class="kd-planweek__addmany">
                <input type="hidden" name="_token" value="{{ csrf_token('week_add' ~ template.id) }}">
                <label class="kd-planweek__addlabel" for="plan-add-weeks">ou d'un coup</label>
                <input type="number" name="count" id="plan-add-weeks" value="4"
                       min="1" max="{{ remaining }}" class="kd-input kd-planweek__addcount"
                       aria-label="Nombre de semaines à ajouter">
                <button type="submit" class="kd-btn kd-btn--ghost kd-btn--sm">
                    {{ ux_icon('lucide:plus') }} Ajouter
                </button>
            </form>
        {% else %}
            <p class="kd-planweek__addfull">Plan au maximum : 52 semaines.</p>
        {% endif %}
    </div>
</div>
