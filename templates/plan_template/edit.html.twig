{% extends 'base.html.twig' %}

{% block title %}Éditer — {{ template.title }}{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}

    <div class="kd-actionbar">
        <a href="{{ path('app_plan_template_index') }}" class="kd-backlink">
            {{ ux_icon('lucide:arrow-left') }} Mes plans
        </a>
        <div class="kd-actionbar__end">
            <a href="{{ path('app_plan_template_show', {id: template.id}) }}" class="kd-btn kd-btn--secondary kd-btn--sm">
                {{ ux_icon('lucide:arrow-right') }} Voir le plan
            </a>
        </div>
    </div>

    {# En-tête à édition en ligne : cliquer le titre ou la description pour les
       modifier (contrôleur `inline-edit`, champs semi-invisibles). C'est le seul
       chemin d'édition des métadonnées : il n'y a plus de formulaire, et le nombre
       de semaines se règle au pied de la trame.
       `rename` (posé par la création en un clic) ouvre le titre d'emblée. #}
    <div class="kd-pagehead">
        <div>
            <p class="kd-eyebrow">Éditeur de plan</p>
            <h1 class="kd-title kd-inlineedit"
                data-controller="inline-edit"
                data-inline-edit-autofocus-value="{{ app.request.query.get('rename') ? 'true' : 'false' }}"
                data-inline-edit-url-value="{{ path('app_plan_template_meta', {id: template.id}) }}"
                data-inline-edit-token-value="{{ csrf_token('plan_meta' ~ template.id) }}"
                data-inline-edit-field-value="title"
                data-inline-edit-target="display"
                data-value="{{ template.title }}"
                data-action="click->inline-edit#start"
                title="Cliquer pour renommer">{{ template.title }}</h1>

            <p class="kd-lead kd-inlineedit kd-inlineedit--desc{{ template.description ? '' : ' kd-inlineedit--empty' }}"
               data-controller="inline-edit"
               data-inline-edit-url-value="{{ path('app_plan_template_meta', {id: template.id}) }}"
               data-inline-edit-token-value="{{ csrf_token('plan_meta' ~ template.id) }}"
               data-inline-edit-field-value="description"
               data-inline-edit-type-value="textarea"
               data-inline-edit-placeholder-value="+ Ajouter une description"
               data-inline-edit-target="display"
               data-value="{{ template.description }}"
               data-action="click->inline-edit#start"
               title="Cliquer pour modifier">{{ template.description ?: '+ Ajouter une description' }}</p>
        </div>
    </div>

    {# À quoi sert ce plan. Conteneur cible d'un Turbo Stream : les mutations de
       rattachement ne touchent que son CONTENU (action="update"), l'id survit. #}
    <div id="plan-goals">
        {{ include('plan_template/_goals.html.twig') }}
    </div>

    {# Trame — conteneur cible des Turbo Streams. Le contrôleur `plangrid` porte le
       glisser-déposer inter-cases et la mini-modale d'édition rapide. Il enveloppe
       la grille ET la modale : les mutations de trame ne touchent que le CONTENU de
       #plan-grid (action="update"), la modale et le contrôleur survivent. #}
    <section class="kd-editsection" data-controller="plangrid"
             data-plangrid-grid-url-value="{{ path('app_plan_template_grid', {id: template.id}) }}">
        <p class="kd-editsection__title">Trame</p>
        <p class="kd-editsection__hint">
            Le « + » d'un jour ouvre la palette sur cette case : taper une séance la
            pose. À la souris, on peut aussi armer une séance puis tamponner les cases,
            ou la glisser directement. Une séance posée s'ouvre en édition rapide (sa
            progression est propre à cette case, les autres ne bougent pas), et son
            menu porte le reste : déplacer, retirer.
        </p>
        {# `kd-libsheet` : sous 900px la palette n'est plus un volet empilé au-dessus
           de la trame mais une feuille qui monte du bas, ouverte sur une case précise
           (même mécanique que la bibliothèque du compositeur, cf. components.css). #}
        <div class="kd-planeditor kd-libsheet" data-plangrid-target="sheet">
            {# Voile de la feuille : inerte tant que `kd-libsheet--open` n'est pas
               posée. Purement visuel, la fermeture au clic extérieur est portée par
               le contrôleur, sur le document. #}
            <div class="kd-composer__scrim"></div>
            <div class="kd-composer__lib">
                {{ include('plan_template/_palette.html.twig') }}
            </div>
            <div class="kd-composer__main">
                <div id="plan-grid">
                    {{ include('plan_template/_grid.html.twig') }}
                </div>
            </div>
        </div>

        {# Mini-modale d'édition rapide : le panneau des exercices de la copie locale
           est chargé en fetch dans #quick-panel, puis re-rendu par Turbo Stream à
           chaque enregistrement. data-turbo="false" : Turbo n'intercepte aucun
           formulaire de la modale, le contrôleur applique lui-même les streams. #}
        <dialog class="kd-modal kd-modal--quick" data-plangrid-target="dialog" data-turbo="false"
                data-action="click->plangrid#backdrop">
            <div class="kd-modal__card kd-modal__card--quick">
                <header class="kd-modal__head">
                    <span class="kd-modal__title">{{ ux_icon('lucide:sliders-horizontal') }} Édition rapide</span>
                    <div class="kd-modal__headactions">
                        <a data-plangrid-target="fullLink" href="#" class="kd-btn kd-btn--secondary kd-btn--sm">
                            {{ ux_icon('lucide:square-pen') }} Édition complète
                        </a>
                        <button type="button" class="kd-modal__close" data-action="plangrid#close" aria-label="Fermer">
                            {{ ux_icon('lucide:x') }}
                        </button>
                    </div>
                </header>
                <div id="quick-panel" class="kd-quickedit" data-plangrid-target="panel"></div>
            </div>
        </dialog>
    </section>

    {# Dupliquer #}
    <section class="kd-editsection">
        <p class="kd-editsection__title">Dupliquer</p>
        <div class="kd-card" style="max-width:640px;">
            <form method="post" action="{{ path('app_plan_template_duplicate', {id: template.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('duplicate' ~ template.id) }}">
                <button type="submit" class="kd-btn kd-btn--secondary">
                    {{ ux_icon('lucide:copy') }} Dupliquer ce plan
                </button>
            </form>
        </div>
    </section>

    {# Zone dangereuse #}
    <section class="kd-editsection">
        <p class="kd-editsection__title">Zone dangereuse</p>
        {{ include('plan_template/_delete_form.html.twig') }}
    </section>
{% endblock %}
