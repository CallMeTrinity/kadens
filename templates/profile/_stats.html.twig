{# Statistiques d'un athlète : réalisé du mois et depuis le début, compteurs de
   bibliothèque, volume réalisé et répartition par activité.

   Extrait de profile/index pour être réutilisé tel quel sur la page athlète du
   coach (ProfileStats::for() prend déjà n'importe quel User). Aucun `app.user`
   ici : tout vient des paramètres.

   Paramètres :
   - stats : sortie de ProfileStats::for($user)
   - own   : true = c'est mon profil (tutoiement), false = celui d'un athlète suivi #}
{% import 'components/_activity.html.twig' as activity %}
{% set own = own|default(false) %}

<section class="kd-section">
    <div class="kd-pagehead kd-pagehead--sub">
        <div>
            <p class="kd-eyebrow kd-eyebrow--accent">Statistiques</p>
            <h2 class="kd-title kd-title--sm">{{ own ? 'Ce que tu as accompli' : 'Ce qui a été accompli' }}</h2>
        </div>
    </div>

    <div class="kd-grid kd-grid--2 kd-section__block">
        <section class="kd-card">
            <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:calendar-check') }} Ce mois</h3>
            {{ include('components/_status_stats.html.twig', {stats: stats.month, hero: true}) }}
        </section>
        <section class="kd-card">
            <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:trending-up') }} Depuis le début</h3>
            {{ include('components/_status_stats.html.twig', {stats: stats.allTime}) }}
        </section>
    </div>

    {# Compteurs bibliothèque #}
    <div class="kd-grid kd-grid--3 kd-section__block">
        {% set counters = [
            { icon: 'lucide:clipboard-list', value: stats.counts.workouts, label: 'Séances' },
            { icon: 'lucide:layers', value: stats.counts.plans, label: 'Plans' },
            { icon: 'lucide:dumbbell', value: stats.counts.exercises, label: 'Exercices' },
        ] %}
        {% for c in counters %}
            <div class="kd-metric">
                <span class="kd-metric__icon">{{ ux_icon(c.icon) }}</span>
                <div>
                    <div class="kd-metric__value">{{ c.value }}</div>
                    <div class="kd-metric__label">{{ c.label }}</div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Volume réalisé + répartition par activité #}
    {% set vol = stats.volume %}
    <div class="kd-grid kd-grid--2 kd-section__block">
        <section class="kd-card">
            <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:flame') }} Volume réalisé</h3>
            <div class="kd-profile__tiles">
                <div class="kd-profile__tile">
                    <span class="kd-profile__tileicon">{{ ux_icon('lucide:dumbbell') }}</span>
                    <div class="kd-stat__value">{{ vol.tonnageLabel }}</div>
                    <div class="kd-stat__label">Tonnage soulevé · {{ vol.gymSets }} séries</div>
                </div>
                {% if vol.running.meters > 0 or vol.running.seconds > 0 %}
                    <div class="kd-profile__tile">
                        <span class="kd-profile__tileicon">{{ ux_icon('lucide:footprints') }}</span>
                        <div class="kd-stat__value">{{ vol.running.distanceLabel }}</div>
                        <div class="kd-stat__label">Course · {{ vol.running.durationLabel }}</div>
                    </div>
                {% endif %}
                {% if vol.cycling.meters > 0 or vol.cycling.seconds > 0 %}
                    <div class="kd-profile__tile">
                        <span class="kd-profile__tileicon">{{ ux_icon('lucide:bike') }}</span>
                        <div class="kd-stat__value">{{ vol.cycling.distanceLabel }}</div>
                        <div class="kd-stat__label">Vélo · {{ vol.cycling.durationLabel }}</div>
                    </div>
                {% endif %}
                {% if vol.swimming.meters > 0 or vol.swimming.seconds > 0 %}
                    <div class="kd-profile__tile">
                        <span class="kd-profile__tileicon">{{ ux_icon('lucide:waves') }}</span>
                        <div class="kd-stat__value">{{ vol.swimming.distanceLabel }}</div>
                        <div class="kd-stat__label">Natation · {{ vol.swimming.durationLabel }}</div>
                    </div>
                {% endif %}
            </div>
        </section>

        <section class="kd-card">
            <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:activity') }} Répartition par activité</h3>
            {% if stats.activityCounts is empty %}
                <div class="kd-empty">
                    {{ ux_icon('lucide:activity') }}
                    <div>Aucune séance faite pour l'instant.</div>
                </div>
            {% else %}
                {% set maxSessions = stats.activityCounts|reduce((m, r) => max(m, r.sessions), 0) %}
                <ul class="kd-actbars">
                    {% for row in stats.activityCounts %}
                        <li class="kd-actbar">
                            <div class="kd-actbar__head">
                                {{ activity.badge(row.activity) }}
                                <span class="kd-actbar__count">{{ row.sessions }} séance{{ row.sessions > 1 ? 's' }}</span>
                            </div>
                            <div class="kd-actbar__track">
                                <span class="kd-actbar__fill kd-actbar__fill--{{ activity.modifier(row.activity) ?: 'neutral' }}"
                                      style="width:{{ maxSessions > 0 ? (row.sessions / maxSessions * 100)|round : 0 }}%"></span>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    </div>
</section>
