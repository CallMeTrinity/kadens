{% extends 'base.html.twig' %}

{# Profil : une fiche courte. L'identité et les records clés en aplat encre,
   puis trois onglets (ProfileTab) servis par des liens `?tab=` — chaque onglet
   a son URL et la page se rend entière, sans JS. #}

{% block title %}Profil — Kadens{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}

    {% set u = app.user %}
    <div class="kd-pfile">
        {{ include('profile/_hero.html.twig', {athlete: u, stats: stats, own: true}) }}

        <nav class="kd-pfile__tabs" aria-label="Rubriques du profil">
            {% for t in tabs %}
                {# L'aperçu est l'onglet par défaut : son URL n'a pas de `tab`. #}
                <a href="{{ path('app_profile', t.value == 'overview' ? {} : {tab: t.value}) }}"
                   class="kd-pfile__tab{{ t == tab ? ' is-active' }}"
                   {{ t == tab ? 'aria-current="page"' : '' }}>{{ t.label }}</a>
            {% endfor %}
        </nav>

        {% if tab.value == 'overview' %}
            {{ include('profile/_overview.html.twig', {stats: stats, hrZones: hrZones, athlete: u, own: true}) }}
        {% elseif tab.value == 'sheet' %}
            {{ include('profile/_sheet.html.twig', {stats: stats, own: true}) }}
        {% else %}
            {{ include('profile/_summary.html.twig', {stats: stats, own: true}) }}
        {% endif %}
    </div>
{% endblock %}
