{% extends 'base.html.twig' %}
{% import 'components/_activity.html.twig' as activity %}

{% block title %}Profil — Kadens{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <p class="kd-flash" role="status">{{ ux_icon('lucide:circle-check') }} {{ message }}</p>
    {% endfor %}

    {# ============================== EN-TÊTE ATHLÈTE ========================= #}
    {% set u = app.user %}
    <header class="kd-phero">
        <span class="kd-phero__avatar" aria-hidden="true">{{ u.userIdentifier|first|upper }}</span>
        <div class="kd-phero__main">
            <p class="kd-eyebrow">Profil</p>
            <h1 class="kd-phero__name">{{ u.userIdentifier }}</h1>
            {% set vitals = [
                u.age is not null ? u.age ~ ' ans',
                u.sex ? u.sex.label,
                u.weightKg is not null ? (u.weightKg|number_format(u.weightKg == u.weightKg|round ? 0 : 1, ',', ' ')) ~ ' kg',
                u.mainGoal ? u.mainGoal.label,
            ]|filter(v => v) %}
            {% if vitals is not empty %}
                <ul class="kd-vitals">
                    {% for v in vitals %}<li class="kd-vitals__item">{{ v }}</li>{% endfor %}
                </ul>
            {% endif %}
        </div>
        <a href="{{ path('app_profile_edit') }}" class="kd-btn kd-btn--primary kd-phero__edit">
            {{ ux_icon('lucide:square-pen') }} Modifier ma fiche
        </a>
    </header>

    {# ============================ OBJECTIFS À VENIR ======================== #}
    <section class="kd-section">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Objectifs</p>
                <h2 class="kd-title kd-title--sm">Vers quoi tu t'entraînes</h2>
            </div>
            <a href="{{ path('app_goal_index') }}" class="kd-btn kd-btn--ghost">
                {{ ux_icon('lucide:target') }} Tous les objectifs
            </a>
        </div>
        {% if upcomingGoals is empty %}
            <div class="kd-card kd-section__block">
                <div class="kd-empty">
                    {{ ux_icon('lucide:target') }}
                    <div>Aucune échéance en vue. <a href="{{ path('app_goal_new') }}">Fixe-toi un objectif</a> pour donner un cap à tes plans.</div>
                </div>
            </div>
        {% else %}
            <div class="kd-goallist kd-section__block">
                {% for goal in upcomingGoals %}
                    {{ include('goal/_card.html.twig', {goal: goal}) }}
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {# =============================== COACHING =============================== #}
    {% if coachingReceived is not empty or coachingActive is not empty %}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Coaching</p>
                    <h2 class="kd-title kd-title--sm">
                        {{ coachingReceived is not empty ? 'Une demande t\'attend' : 'Qui t\'entraîne' }}
                    </h2>
                </div>
                <a href="{{ path('app_coaching_index') }}" class="kd-btn kd-btn--ghost">
                    {{ ux_icon('lucide:users') }} Gérer mes relations
                </a>
            </div>
            <div class="kd-coachlist kd-section__block">
                {% for relation in coachingReceived|merge(coachingActive) %}
                    {{ include('components/_coaching_card.html.twig', {relation: relation, me: u}) }}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# ============================ STATS GÉNÉRALES ========================== #}
    <section class="kd-section">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Statistiques</p>
                <h2 class="kd-title kd-title--sm">Ce que tu as accompli</h2>
            </div>
        </div>

        <div class="kd-grid kd-grid--2 kd-section__block">
            <section class="kd-card">
                <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:calendar-check') }} Ce mois</h3>
                {{ include('components/_status_stats.html.twig', {stats: stats.month, hero: true}) }}
            </section>
            <section class="kd-card">
                <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:trending-up') }} Depuis le début</h3>
                {{ include('components/_status_stats.html.twig', {stats: stats.allTime}) }}
            </section>
        </div>

        {# Compteurs bibliothèque #}
        <div class="kd-grid kd-grid--3 kd-section__block">
            {% set counters = [
                { icon: 'lucide:clipboard-list', value: stats.counts.workouts, label: 'Séances' },
                { icon: 'lucide:layers', value: stats.counts.plans, label: 'Plans' },
                { icon: 'lucide:dumbbell', value: stats.counts.exercises, label: 'Exercices' },
            ] %}
            {% for c in counters %}
                <div class="kd-metric">
                    <span class="kd-metric__icon">{{ ux_icon(c.icon) }}</span>
                    <div>
                        <div class="kd-metric__value">{{ c.value }}</div>
                        <div class="kd-metric__label">{{ c.label }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Volume réalisé + répartition par activité #}
        {% set vol = stats.volume %}
        <div class="kd-grid kd-grid--2 kd-section__block">
            <section class="kd-card">
                <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:flame') }} Volume réalisé</h3>
                <div class="kd-profile__tiles">
                    <div class="kd-profile__tile">
                        <span class="kd-profile__tileicon">{{ ux_icon('lucide:dumbbell') }}</span>
                        <div class="kd-stat__value">{{ vol.tonnageLabel }}</div>
                        <div class="kd-stat__label">Tonnage soulevé · {{ vol.gymSets }} séries</div>
                    </div>
                    {% if vol.running.meters > 0 or vol.running.seconds > 0 %}
                        <div class="kd-profile__tile">
                            <span class="kd-profile__tileicon">{{ ux_icon('lucide:footprints') }}</span>
                            <div class="kd-stat__value">{{ vol.running.distanceLabel }}</div>
                            <div class="kd-stat__label">Course · {{ vol.running.durationLabel }}</div>
                        </div>
                    {% endif %}
                    {% if vol.cycling.meters > 0 or vol.cycling.seconds > 0 %}
                        <div class="kd-profile__tile">
                            <span class="kd-profile__tileicon">{{ ux_icon('lucide:bike') }}</span>
                            <div class="kd-stat__value">{{ vol.cycling.distanceLabel }}</div>
                            <div class="kd-stat__label">Vélo · {{ vol.cycling.durationLabel }}</div>
                        </div>
                    {% endif %}
                    {% if vol.swimming.meters > 0 or vol.swimming.seconds > 0 %}
                        <div class="kd-profile__tile">
                            <span class="kd-profile__tileicon">{{ ux_icon('lucide:waves') }}</span>
                            <div class="kd-stat__value">{{ vol.swimming.distanceLabel }}</div>
                            <div class="kd-stat__label">Natation · {{ vol.swimming.durationLabel }}</div>
                        </div>
                    {% endif %}
                </div>
            </section>

            <section class="kd-card">
                <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:activity') }} Répartition par activité</h3>
                {% if stats.activityCounts is empty %}
                    <div class="kd-empty">
                        {{ ux_icon('lucide:activity') }}
                        <div>Aucune séance faite pour l'instant.</div>
                    </div>
                {% else %}
                    {% set maxSessions = stats.activityCounts|reduce((m, r) => max(m, r.sessions), 0) %}
                    <ul class="kd-actbars">
                        {% for row in stats.activityCounts %}
                            <li class="kd-actbar">
                                <div class="kd-actbar__head">
                                    {{ activity.badge(row.activity) }}
                                    <span class="kd-actbar__count">{{ row.sessions }} séance{{ row.sessions > 1 ? 's' }}</span>
                                </div>
                                <div class="kd-actbar__track">
                                    <span class="kd-actbar__fill kd-actbar__fill--{{ activity.modifier(row.activity) ?: 'neutral' }}"
                                          style="width:{{ maxSessions > 0 ? (row.sessions / maxSessions * 100)|round : 0 }}%"></span>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        </div>
    </section>

    {# ============================== FICHE ATHLÈTE ========================== #}
    {% set card = stats.athlete %}
    <section class="kd-section">
        <div class="kd-pagehead kd-pagehead--sub">
            <div>
                <p class="kd-eyebrow kd-eyebrow--accent">Fiche athlète</p>
                <h2 class="kd-title kd-title--sm">Tes mesures et records</h2>
            </div>
            {% if card.hasAny %}
                <a href="{{ path('app_profile_edit') }}" class="kd-btn kd-btn--ghost">
                    {{ ux_icon('lucide:square-pen') }} Éditer
                </a>
            {% endif %}
        </div>

        {% if not card.hasAny %}
            <div class="kd-card">
                <div class="kd-empty">
                    {{ ux_icon('lucide:user') }}
                    <div>Ta fiche est vide. <a href="{{ path('app_profile_edit') }}">Renseigne tes infos</a> (taille, poids, records…).</div>
                </div>
            </div>
        {% else %}
            <div class="kd-grid kd-grid--3 kd-section__block" style="align-items:start;">
                {% set groups = [
                    { title: 'Identité',  icon: 'lucide:user',       rows: card.identity },
                    { title: 'Force',     icon: 'lucide:dumbbell',   rows: card.strength },
                    { title: 'Endurance', icon: 'lucide:footprints', rows: card.endurance },
                ] %}
                {% for g in groups %}
                    <section class="kd-card">
                        <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon(g.icon) }} {{ g.title }}</h3>
                        <dl class="kd-deflist kd-deflist--profile">
                            {% for r in g.rows %}
                                <dt>{{ r.label }}</dt>
                                <dd class="{{ r.derived ?? false ? 'kd-deflist__derived' }}{{ r.value is null ? ' kd-deflist__empty' }}">{{ r.value ?? '—' }}</dd>
                            {% endfor %}
                        </dl>
                    </section>
                {% endfor %}
            </div>

            {# Zones cardio : n'a de sens qu'avec une FC max renseignée (bornes BPM). #}
            {% if hrZones|first.max is not null %}
                <section class="kd-card kd-hrzones kd-section__block">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:heart-pulse') }} Zones cardio</h3>
                    <ul class="kd-hrzones__list">
                        {% for band in hrZones %}
                            <li class="kd-hrzone kd-hrzone--{{ band.zone.value }}">
                                <span class="kd-hrzone__tag">{{ band.zone.value|upper }}</span>
                                <span class="kd-hrzone__name">{{ band.zone.label }}</span>
                                <span class="kd-hrzone__bpm">{{ band.min }}–{{ band.max }} bpm</span>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="kd-hrzones__hint">Dérivées de ta FC max/repos (Karvonen). <a href="{{ path('app_profile_edit') }}">Ajuster</a>.</p>
                </section>
            {% endif %}

            {% if card.bio %}
                <section class="kd-card kd-section__block">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:quote') }} Bio</h3>
                    <p class="kd-profile__bio">{{ card.bio }}</p>
                </section>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}
