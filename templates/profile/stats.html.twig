{% extends 'base.html.twig' %}
{% import 'components/_activity.html.twig' as activity %}

{# Statistiques détaillées sur une fenêtre de temps choisie.

   Rendu 100 % serveur, aucune bibliothèque de graphiques : des div
   proportionnelles suffisent, restent imprimables et ne coûtent rien à
   AssetMapper. Les hauteurs/largeurs viennent déjà calculées de TrainingStats —
   le template ne fait aucune arithmétique de mise à l'échelle.

   Un principe de lecture tient toute la page : chaque chiffre dit d'où il
   vient. Le tonnage vient du RÉALISÉ (séries loguées), les distances du
   PRESCRIT des séances faites (le cardio ne se logue jamais), l'observance des
   statuts. Une séance d'avant Kadens Live compte donc en régularité sans porter
   de tonnage — c'est exact, et la page le dit plutôt que de le combler.

   `subject` = l'athlète regardé, ou null pour soi. `TrainingStats` prend
   n'importe quel `User` : la page est la même, servie par
   `CoachController::athleteStats`. Tout ce qui dépend du lecteur (titre,
   destinations) est calculé en tête de `body` ; le corps ne sait pas qui
   regarde.

   Quatre rubriques (`tab`, cf. StatsTab), chacune son lien `?tab=` : la vue
   d'ensemble (assiduité, répartition), la salle (volume soulevé, régions,
   rampe, records) et l'endurance (volume, rampe en durée, zones, records,
   prévu contre réel ; tout sauf le volume se lit sur le seul réel importé,
   et le dit), et le ressenti (forme, difficulté, sur toutes les séances). Une
   rubrique ne
   filtre aucun chiffre, elle choisit les blocs rendus : `stats` est le même
   agrégat quel que soit l'onglet. #}

{% block title %}Statistiques{% if subject|default(null) %} — {{ subject.displayName }}{% endif %} — Kadens{% endblock %}

{% block body %}
    {% set subject = subject|default(null) %}
    {% set historyPath = subject ? path('app_coach_athlete_history', {id: subject.id}) : path('app_profile_history') %}
    {% set logPath = subject ? path('app_coach_athlete_log', {id: subject.id}) : path('app_profile_log') %}
    {% set backPath = subject ? path('app_coach_athlete', {id: subject.id}) : path('app_profile') %}
    {% set vol = stats.volume %}
    {% set reg = stats.regularity %}
    {% set prog = stats.progression %}
    {% set feel = stats.feeling %}
    {% set statsRoute = subject ? 'app_coach_athlete_stats' : 'app_profile_stats' %}
    {% set feelingPath = path(statsRoute, (subject ? {id: subject.id} : {})|merge({range: period.queryValue, tab: 'feeling'})) %}

    <div class="kd-pagehead">
        <div>
            <p class="kd-eyebrow kd-eyebrow--accent">Statistiques</p>
            {# Pas de pronom sujet pour l'athlète : le genre n'est pas une donnée
               d'affichage (User.sex est nullable et sert au DOTS). #}
            <h1 class="kd-title">{{ subject ? 'Ce qui a été fait' : 'Ce que tu as fait' }}</h1>
            <p class="kd-pagehead__lead">
                {%- if subject %}{{ subject.displayName }} · {% endif -%}
                {{ period.label }}
            </p>
        </div>
        <div class="kd-actionbar__end">
            {# L'historique n'a pas de fenêtre : il n'hérite donc pas du `?range=`
               courant, et c'est volontaire. #}
            <a href="{{ logPath }}" class="kd-btn kd-btn--secondary">
                {{ ux_icon('lucide:clipboard-list') }} Journal
            </a>
            <a href="{{ historyPath }}" class="kd-btn kd-btn--ghost">
                {{ ux_icon('lucide:history') }} Historique
            </a>
            <a href="{{ backPath }}" class="kd-btn kd-btn--ghost">
                {{ ux_icon('lucide:arrow-left') }} {{ subject ? 'Retour à sa fiche' : 'Retour au profil' }}
            </a>
        </div>
    </div>

    {{ include('profile/_stats_tabs.html.twig', {tab: tab, tabs: tabs, period: period, subject: subject}) }}
    {{ include('profile/_stats_range.html.twig', {period: period, ranges: ranges, months: months, subject: subject, tab: tab}) }}

    {% if tab.value == 'overview' %}
        {# ============================== BANDEAU DE TÊTE ========================= #}
        {# Les quatre repères qu'on lit avant tout le reste. Volontairement mêlés :
           une séance, une observance, un tonnage, des séries — trois sources, un
           seul coup d'œil. #}
        <div class="kd-grid kd-grid--4 kd-section__block">
            {% set headline = [
                {icon: 'lucide:calendar-check', value: reg.sessions, label: 'séance' ~ (reg.sessions > 1 ? 's') ~ ' faite' ~ (reg.sessions > 1 ? 's')},
                {icon: 'lucide:target', value: stats.adherence.adherence is null ? '—' : (stats.adherence.adherence * 100)|round ~ ' %', label: 'observance'},
                {icon: 'lucide:dumbbell', value: vol.gym.tonnageLabel, label: 'tonnage soulevé'},
                {icon: 'lucide:layers', value: vol.gym.workingSets, label: 'série' ~ (vol.gym.workingSets > 1 ? 's') ~ ' de travail'},
            ] %}
            {% for m in headline %}
                <div class="kd-metric">
                    <span class="kd-metric__icon">{{ ux_icon(m.icon) }}</span>
                    <div>
                        <div class="kd-metric__value">{{ m.value }}</div>
                        <div class="kd-metric__label">{{ m.label }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Le ressenti en une ligne, et le chemin vers son onglet. Absent tant que
           rien n'est noté : la vue d'ensemble n'annonce pas un vide facultatif. #}
        {% if feel.rated > 0 %}
            <a href="{{ feelingPath }}" class="kd-card kd-feelteaser kd-section__block">
                <span class="kd-metric__icon">{{ ux_icon('lucide:heart-pulse') }}</span>
                <span class="kd-feelteaser__body">
                    {% if feel.feeling is not null %}<strong>{{ feel.feelingLabel }}</strong> en moyenne{% endif %}
                    {%- if feel.feeling is not null and feel.sessionRpe is not null %} · {% endif -%}
                    {% if feel.sessionRpe is not null %}difficulté <strong>{{ feel.sessionRpe|number_format(1, ',', ' ') }}/10</strong>{% endif %}
                    <span class="kd-deflist__note">({{ feel.rated }} séance{{ feel.rated > 1 ? 's' }} notée{{ feel.rated > 1 ? 's' }})</span>
                </span>
                <span class="kd-feelteaser__go">{{ ux_icon('lucide:arrow-right') }}</span>
            </a>
        {% endif %}

        {# ========================== OBSERVANCE + RÉGULARITÉ ===================== #}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Assiduité</p>
                    <h2 class="kd-title kd-title--sm">Tenu, manqué, à venir</h2>
                </div>
            </div>

            <div class="kd-grid kd-grid--2 kd-section__block">
                <section class="kd-card">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:target') }} Observance</h3>
                    {{ include('components/_status_stats.html.twig', {stats: stats.adherence, hero: true}) }}
                </section>

                <section class="kd-card">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:calendar-days') }} Régularité</h3>
                    {% if reg.sessions == 0 %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:calendar-off') }}
                            <div>Aucune séance faite sur cette période.</div>
                        </div>
                    {% else %}
                        {# Grille dt/dd à plat : .kd-deflist EST la grille, un
                           conteneur par ligne en casserait l'alignement. #}
                        <dl class="kd-deflist">
                            {% if reg.perWeek is not null %}
                                <dt>Rythme</dt>
                                <dd><strong>{{ reg.perWeek|number_format(1, ',', ' ') }}</strong> séance{{ reg.perWeek > 1 ? 's' }} par semaine</dd>
                            {% endif %}
                            <dt>Jours actifs</dt>
                            <dd>{{ reg.activeDays }} jour{{ reg.activeDays > 1 ? 's' }}</dd>
                            {# Deux séries, deux choses différentes : le record de la
                               période, et celle qui court encore. #}
                            <dt>Série en cours</dt>
                            <dd>
                                {% if reg.currentStreak > 0 %}
                                    <strong>{{ reg.currentStreak }}</strong> semaine{{ reg.currentStreak > 1 ? 's' }} d'affilée
                                {% else %}
                                    Interrompue
                                {% endif %}
                            </dd>
                            <dt>Meilleure série</dt>
                            <dd>{{ reg.bestStreak }} semaine{{ reg.bestStreak > 1 ? 's' }} d'affilée</dd>
                            {% if reg.bestWeek %}
                                <dt>Meilleure semaine</dt>
                                <dd>{{ reg.bestWeek.sessions }} séance{{ reg.bestWeek.sessions > 1 ? 's' }} <span class="kd-deflist__note">({{ reg.bestWeek.label }})</span></dd>
                            {% endif %}
                            {% if reg.bestMonth and period.range.value != 'month' %}
                                <dt>Meilleur mois</dt>
                                <dd>{{ reg.bestMonth.sessions }} séance{{ reg.bestMonth.sessions > 1 ? 's' }} <span class="kd-deflist__note">({{ reg.bestMonth.label }})</span></dd>
                            {% endif %}
                        </dl>
                    {% endif %}
                </section>
            </div>
        </section>

        {# ====================== ACTIVITÉS + OBSERVANCE PAR PLAN ================= #}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Répartition</p>
                    <h2 class="kd-title kd-title--sm">Par activité et par plan</h2>
                </div>
            </div>

            <div class="kd-grid kd-grid--2 kd-section__block">
                <section class="kd-card">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:activity') }} Activités</h3>
                    {% if stats.activityCounts is empty %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:activity') }}
                            <div>Aucune séance faite sur cette période.</div>
                        </div>
                    {% else %}
                        {% set maxSessions = stats.activityCounts|reduce((m, r) => max(m, r.sessions), 0) %}
                        <ul class="kd-actbars">
                            {% for row in stats.activityCounts %}
                                <li class="kd-actbar">
                                    <div class="kd-actbar__head">
                                        {{ activity.badge(row.activity) }}
                                        <span class="kd-actbar__count">{{ row.sessions }} séance{{ row.sessions > 1 ? 's' }}</span>
                                    </div>
                                    <div class="kd-actbar__track">
                                        <span class="kd-actbar__fill{{ row.activity ? ' kd-actbar__fill--act kd-act--' ~ activity.modifier(row.activity) }}"
                                              style="width:{{ maxSessions > 0 ? (row.sessions / maxSessions * 100)|round : 0 }}%"></span>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>

                <section class="kd-card">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:layers') }} Par plan</h3>
                    {% if stats.plans is empty %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:layers') }}
                            <div>Aucune séance planifiée sur cette période.</div>
                        </div>
                    {% else %}
                        <ul class="kd-planbars">
                            {% for plan in stats.plans %}
                                <li class="kd-planbar">
                                    <div class="kd-planbar__head">
                                        {% if plan.planId %}
                                            <a class="kd-planbar__name" href="{{ path('app_plan_template_show', {id: plan.planId}) }}">{{ plan.planTitle }}</a>
                                        {% else %}
                                            <span class="kd-planbar__name kd-planbar__name--loose">{{ plan.planTitle }}</span>
                                        {% endif %}
                                        <span class="kd-planbar__pct">{{ plan.adherence is null ? '—' : (plan.adherence * 100)|round ~ ' %' }}</span>
                                    </div>
                                    <div class="kd-obar" role="img"
                                         aria-label="{{ plan.done }} faites, {{ plan.missed }} manquées, {{ plan.planned }} prévues">
                                        {% for key, count in {'done': plan.done, 'missed': plan.missed, 'planned': plan.planned} %}
                                            {% if count > 0 %}
                                                <span class="kd-obar__seg kd-obar__seg--{{ key }}" style="flex:{{ count }}"></span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                    <p class="kd-planbar__note">
                                        {{ plan.done }} faite{{ plan.done > 1 ? 's' }} ·
                                        {{ plan.missed }} manquée{{ plan.missed > 1 ? 's' }} ·
                                        {{ plan.planned }} à venir
                                    </p>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>
            </div>
        </section>
    {% elseif tab.value == 'gym' %}
        {# ============================ VOLUME SOULEVÉ ============================ #}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Volume</p>
                    <h2 class="kd-title kd-title--sm">Ce qui a été soulevé</h2>
                </div>
            </div>

            <div class="kd-grid kd-grid--1 kd-section__block">
                <section class="kd-card">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:dumbbell') }} Salle</h3>
                    {% if vol.gym.sessions == 0 %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:dumbbell') }}
                            <div>Aucune série loguée sur cette période.</div>
                            <p class="kd-empty__hint">Le tonnage se lit sur le réalisé : une séance cochée « faite » sans séries loguées compte en assiduité, pas en volume.</p>
                        </div>
                    {% else %}
                        <div class="kd-profile__tiles">
                            <div class="kd-profile__tile">
                                <span class="kd-profile__tileicon">{{ ux_icon('lucide:weight') }}</span>
                                <div class="kd-stat__value">{{ vol.gym.tonnageLabel }}</div>
                                <div class="kd-stat__label">Tonnage · {{ vol.gym.workingSets }} série{{ vol.gym.workingSets > 1 ? 's' }}</div>
                            </div>
                            <div class="kd-profile__tile">
                                <span class="kd-profile__tileicon">{{ ux_icon('lucide:repeat') }}</span>
                                <div class="kd-stat__value">{{ vol.gym.sessions }}</div>
                                <div class="kd-stat__label">Séance{{ vol.gym.sessions > 1 ? 's' }} loguée{{ vol.gym.sessions > 1 ? 's' }}</div>
                            </div>
                            {% if vol.gym.perSessionSets is not null %}
                                <div class="kd-profile__tile">
                                    <span class="kd-profile__tileicon">{{ ux_icon('lucide:layers') }}</span>
                                    <div class="kd-stat__value">{{ vol.gym.perSessionSets|number_format(1, ',', ' ') }}</div>
                                    <div class="kd-stat__label">Séries par séance · {{ vol.gym.perSessionTonnageLabel }}</div>
                                </div>
                            {% endif %}
                            {% if vol.gym.averageRpe is not null %}
                                <div class="kd-profile__tile">
                                    <span class="kd-profile__tileicon">{{ ux_icon('lucide:flame') }}</span>
                                    <div class="kd-stat__value">{{ vol.gym.averageRpe|number_format(1, ',', ' ') }}</div>
                                    <div class="kd-stat__label">RPE moyen</div>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </section>
            </div>

            {# Ventilation par région : même barre empilée que l'analyse d'une séance
               (kd-stack + kd-legend), même service (RegionBreakdown). #}
            {% if stats.regions is not empty %}
                <section class="kd-card kd-section__block">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:pie-chart') }} Où part le volume</h3>
                    <p class="kd-card__note">Part des séries de travail attribuées à chaque région. Une série compte pour chaque zone qu'elle cible.</p>

                    <div class="kd-stack" role="img"
                         aria-label="{% for r in stats.regions %}{{ r.region.label }} {{ r.percent|number_format(0) }} %{{ not loop.last ? ', ' }}{% endfor %}">
                        {% for r in stats.regions %}
                            <span class="kd-stack__seg kd-cat--{{ r.region.rank }}" style="width: {{ r.percent }}%"></span>
                        {% endfor %}
                    </div>

                    <ul class="kd-legend">
                        {% for r in stats.regions %}
                            <li class="kd-legend__item">
                                <span class="kd-legend__key kd-cat--{{ r.region.rank }}" aria-hidden="true"></span>
                                {{ r.region.label }}
                                <span class="kd-legend__val">{{ r.sets }} série{{ r.sets > 1 ? 's' }} · {{ r.percent|number_format(0) }} %</span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        </section>

        {# ============================= PROGRESSION ============================== #}
        {% if prog.points is not empty %}
            <section class="kd-section">
                <div class="kd-pagehead kd-pagehead--sub">
                    <div>
                        <p class="kd-eyebrow kd-eyebrow--accent">Progression</p>
                        <h2 class="kd-title kd-title--sm">
                            {{ prog.granularity == 'week' ? 'Semaine par semaine' : 'Mois par mois' }}
                        </h2>
                    </div>
                </div>

                <section class="kd-card kd-section__block">
                    {% if not prog.hasVolume %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:trending-up') }}
                            <div>Rien à tracer : aucune série loguée sur cette période.</div>
                        </div>
                    {% else %}
                        <p class="kd-card__note">
                            Tonnage de salle par {{ prog.granularity == 'week' ? 'semaine' : 'mois' }}.
                            {% if prog.truncated %}Les 24 dernières seulement{% endif %}
                        </p>

                        <div class="kd-statbars">
                            <div class="kd-prog__bars">
                                {% for p in prog.points %}
                                    <div class="kd-prog__col{{ p.tonnageHeightPct == 0 ? ' is-empty' }}">
                                        <div class="kd-prog__track">
                                            {% if p.tonnageHeightPct > 0 %}
                                                <span class="kd-prog__bar kd-prog__bar--act kd-act--gym"
                                                      style="height: {{ p.tonnageHeightPct }}%"
                                                      title="{{ p.label }} · {{ p.tonnageLabel }} · {{ p.sessions }} séance{{ p.sessions > 1 ? 's' }}"></span>
                                            {% endif %}
                                        </div>
                                        <span class="kd-prog__wk">{{ p.short }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        {# Le graphique n'est pas lisible au lecteur d'écran : la même
                           série est donnée en tableau, masqué visuellement. #}
                        <table class="kd-sr-only">
                            <caption>Tonnage par {{ prog.granularity == 'week' ? 'semaine' : 'mois' }}</caption>
                            <thead><tr><th>Période</th><th>Tonnage</th><th>Séances</th></tr></thead>
                            <tbody>
                                {% for p in prog.points %}
                                    <tr><td>{{ p.label }}</td><td>{{ p.tonnageLabel }}</td><td>{{ p.sessions }}</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </section>
            </section>
        {% endif %}

        {# =============================== RECORDS ================================ #}
        {% if stats.records.top is not empty %}
            <section class="kd-section">
                <div class="kd-pagehead kd-pagehead--sub">
                    <div>
                        <p class="kd-eyebrow kd-eyebrow--accent">Charges</p>
                        <h2 class="kd-title kd-title--sm">Le plus lourd</h2>
                    </div>
                </div>

                <div class="kd-grid kd-grid--2 kd-section__block">
                    <section class="kd-card">
                        <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:trophy') }} Top charges</h3>
                        <ul class="kd-ranklist">
                            {% for lift in stats.records.top %}
                                <li class="kd-ranklist__row">
                                    <span class="kd-ranklist__rank">{{ '%02d'|format(loop.index) }}</span>
                                    <span class="kd-ranklist__name">{{ lift.name }}</span>
                                    <span class="kd-ranklist__val">{{ lift.weightLabel }}</span>
                                    <span class="kd-ranklist__note">{{ lift.workingSets }} série{{ lift.workingSets > 1 ? 's' }} · {{ lift.sessions }} séance{{ lift.sessions > 1 ? 's' }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>

                    <section class="kd-card">
                        <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:medal') }} Nouveaux records</h3>
                        {% if not stats.records.comparable %}
                            {# « Depuis le début » n'a pas de passé antérieur : tous ses
                               maximums sont des records par construction. On le dit
                               plutôt que d'afficher une liste de faux exploits. #}
                            <div class="kd-empty">
                                {{ ux_icon('lucide:infinity') }}
                                <div>Pas de « nouveau » record sur toute l'histoire.</div>
                                <p class="kd-empty__hint">Choisis une fenêtre bornée pour voir ce qui a été battu.</p>
                            </div>
                        {% elseif stats.records.new is empty %}
                            <div class="kd-empty">
                                {{ ux_icon('lucide:medal') }}
                                <div>Aucune charge battue sur cette période.</div>
                            </div>
                        {% else %}
                            <ul class="kd-ranklist">
                                {% for pr in stats.records.new %}
                                    <li class="kd-ranklist__row">
                                        <span class="kd-ranklist__rank kd-ranklist__rank--pr">{{ ux_icon('lucide:arrow-up') }}</span>
                                        <span class="kd-ranklist__name">{{ pr.name }}</span>
                                        <span class="kd-ranklist__val">{{ pr.weightLabel }}</span>
                                        <span class="kd-ranklist__note">avant {{ pr.previousLabel }} · +{{ pr.gainLabel }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </section>
                </div>
            </section>
        {% endif %}
    {% elseif tab.value == 'endurance' %}
        {% set endu = stats.endurance %}
        {% set cov = endu.coverage %}
        {% set eprog = endu.progression %}
        {% set sports = [
            {key: 'running', icon: 'lucide:footprints', label: 'Course'},
            {key: 'cycling', icon: 'lucide:bike', label: 'Vélo'},
            {key: 'swimming', icon: 'lucide:waves', label: 'Natation'},
        ] %}

        {# ============================ VOLUME PARCOURU =========================== #}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Volume</p>
                    <h2 class="kd-title kd-title--sm">Ce qui a été parcouru</h2>
                </div>
            </div>

            {# Couverture : la provenance de toute la page, dite avant le premier
               chiffre. Une activité non rattachée ne compte nulle part — sans
               cette ligne, un total plus bas que prévu ne s'expliquerait pas. #}
            {% if cov.sessions > 0 or cov.unattached > 0 %}
                <p class="kd-card__note kd-endu__coverage">
                    {% if cov.sessions > 0 %}
                        <strong>{{ cov.withActivity }}</strong> sortie{{ cov.withActivity > 1 ? 's' }} sur {{ cov.sessions }} lue{{ cov.withActivity > 1 ? 's' }} sur la montre, le reste sur le prescrit.
                    {% endif %}
                    {% if cov.unattached > 0 %}
                        {{ cov.unattached }} activité{{ cov.unattached > 1 ? 's' }} importée{{ cov.unattached > 1 ? 's' }} sans séance, donc hors des chiffres{% if not subject %} : rattache-l{{ cov.unattached > 1 ? 'es' : 'a' }} depuis la page de la séance du même jour{% endif %}.
                    {% endif %}
                </p>
            {% endif %}

            <div class="kd-grid kd-grid--1 kd-section__block">
                <section class="kd-card">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:footprints') }} Endurance</h3>
                    {% set present = sports|filter(e => vol[e.key].meters > 0 or vol[e.key].seconds > 0) %}
                    {% if present is empty %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:footprints') }}
                            <div>Aucune sortie sur cette période.</div>
                        </div>
                    {% else %}
                        <div class="kd-profile__tiles">
                            {% for e in present %}
                                {% set v = vol[e.key] %}
                                {% set real = endu.summary[e.key] ?? null %}
                                <div class="kd-profile__tile">
                                    <span class="kd-profile__tileicon">{{ ux_icon(e.icon) }}</span>
                                    {# Distance en valeur principale, durée en repli : une
                                       sortie prescrite en durée sans allure n'a pas de
                                       distance, et « 0 m » se lirait « rien couru ». #}
                                    <div class="kd-stat__value">{{ v.distanceLabel ?? v.durationLabel }}</div>
                                    <div class="kd-stat__label">{{ e.label }}{{ v.distanceLabel and v.durationLabel ? ' · ' ~ v.durationLabel }} · {{ v.sessions }} sortie{{ v.sessions > 1 ? 's' }}</div>
                                    {# Allure et D+ n'existent que sur le réel : ils disent
                                       sur combien de sorties ils reposent. #}
                                    {% if real and (real.paceLabel or real.elevationLabel) %}
                                        <div class="kd-stat__label kd-endu__real">
                                            {{- real.paceLabel ? real.paceLabel -}}
                                            {{- real.paceLabel and real.elevationLabel ? ' · ' -}}
                                            {{- real.elevationLabel ? 'D+ ' ~ real.elevationLabel -}}
                                            <span class="kd-deflist__note"> (sur {{ real.outings }} sortie{{ real.outings > 1 ? 's' }} importée{{ real.outings > 1 ? 's' }})</span>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                        <p class="kd-card__note">
                            Lu sur l'activité importée quand elle est rattachée à la séance faite, sur son prescrit sinon.
                            {% if present|filter(e => vol[e.key].derivedMeters > 0 or vol[e.key].derivedSeconds > 0) is not empty %}
                                ≈ : en partie déduit de l'allure prescrite.
                            {% endif %}
                        </p>
                    {% endif %}
                </section>
            </div>
        </section>

        {# ================================ RAMPE ================================= #}
        {% if eprog.points is not empty %}
            <section class="kd-section">
                <div class="kd-pagehead kd-pagehead--sub">
                    <div>
                        <p class="kd-eyebrow kd-eyebrow--accent">Progression</p>
                        <h2 class="kd-title kd-title--sm">
                            {{ eprog.granularity == 'week' ? 'Semaine par semaine' : 'Mois par mois' }}
                        </h2>
                    </div>
                </div>

                <section class="kd-card kd-section__block">
                    {% if not eprog.hasVolume %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:trending-up') }}
                            <div>Rien à tracer : aucune sortie chiffrée en durée sur cette période.</div>
                        </div>
                    {% else %}
                        {# En durée : en kilomètres, le vélo écraserait la natation. #}
                        <p class="kd-card__note">
                            Temps d'endurance par {{ eprog.granularity == 'week' ? 'semaine' : 'mois' }}, par sport.
                            {% if eprog.truncated %}Les 24 dernières seulement.{% endif %}
                        </p>

                        <div class="kd-statbars">
                            <div class="kd-prog__bars">
                                {% for p in eprog.points %}
                                    <div class="kd-prog__col{{ p.heightPct == 0 ? ' is-empty' }}">
                                        <div class="kd-prog__track">
                                            {% if p.heightPct > 0 %}
                                                <span class="kd-prog__stack" style="height: {{ p.heightPct }}%"
                                                      title="{{ p.label }} · {{ p.durationLabel }}{% for seg in p.segments %} · {{ seg.activity.label }} {{ seg.durationLabel }}{{ seg.distanceLabel ? ' (' ~ seg.distanceLabel ~ ')' }}{% endfor %}">
                                                    {% for seg in p.segments|filter(seg => seg.seconds > 0) %}
                                                        <span class="kd-prog__seg kd-act--{{ activity.modifier(seg.activity) }}" style="flex: {{ seg.seconds }}"></span>
                                                    {% endfor %}
                                                </span>
                                            {% endif %}
                                        </div>
                                        <span class="kd-prog__wk">{{ p.short }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <ul class="kd-legend">
                            {% for sport in eprog.sports %}
                                <li class="kd-legend__item">
                                    <span class="kd-legend__key kd-legend__key--act kd-act--{{ activity.modifier(sport) }}" aria-hidden="true"></span>
                                    {{ sport.label }}
                                </li>
                            {% endfor %}
                        </ul>

                        <table class="kd-sr-only">
                            <caption>Temps d'endurance par {{ eprog.granularity == 'week' ? 'semaine' : 'mois' }}</caption>
                            <thead><tr><th>Période</th><th>Total</th>{% for e in sports %}<th>{{ e.label }}</th>{% endfor %}</tr></thead>
                            <tbody>
                                {% for p in eprog.points %}
                                    <tr>
                                        <td>{{ p.label }}</td>
                                        <td>{{ p.durationLabel }}</td>
                                        {% for e in sports %}
                                            {% set seg = p.segments|filter(seg => seg.activity.value == e.key)|first %}
                                            <td>{{ seg ? seg.durationLabel ~ (seg.distanceLabel ? ' · ' ~ seg.distanceLabel) : '—' }}</td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </section>
            </section>
        {% endif %}

        {# ============================== INTENSITÉ =============================== #}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Intensité</p>
                    <h2 class="kd-title kd-title--sm">À quelle allure cardiaque</h2>
                </div>
            </div>

            <section class="kd-card kd-section__block">
                <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:heart-pulse') }} Temps en zones</h3>
                {% if endu.zones is null %}
                    <div class="kd-empty">
                        {{ ux_icon('lucide:heart-pulse') }}
                        <div>Aucune sortie importée avec de la fréquence cardiaque sur cette période.</div>
                        <p class="kd-empty__hint">Le temps en zones se calcule à l'import, avec la FC max du profil : sans elle, il n'y en a pas.</p>
                    </div>
                {% else %}
                    <p class="kd-card__note">
                        {{ endu.zones.durationLabel }} sur {{ endu.zones.outings }} sortie{{ endu.zones.outings > 1 ? 's' }} importée{{ endu.zones.outings > 1 ? 's' }}, tous sports confondus.
                        <strong>{{ endu.zones.easyPercent }} %</strong> en Z1-Z2 (repère de l'entraînement polarisé : environ 80 %).
                    </p>
                    {{ include('components/_zonebars.html.twig', {zones: endu.zones.shares}) }}
                {% endif %}
            </section>
        </section>

        {# =============================== RECORDS ================================ #}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Records</p>
                    <h2 class="kd-title kd-title--sm">Les sorties marquantes</h2>
                </div>
            </div>

            <div class="kd-grid kd-grid--2 kd-section__block">
                <section class="kd-card">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:trophy') }} Sur la période</h3>
                    {% if endu.records is empty %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:trophy') }}
                            <div>Aucune sortie importée sur cette période.</div>
                        </div>
                    {% else %}
                        <ul class="kd-ranklist">
                            {% for r in endu.records %}
                                <li class="kd-ranklist__row">
                                    <span class="kd-ranklist__rank">{{ activity.badge(r.activity, false) }}</span>
                                    <a class="kd-ranklist__name" href="{{ path('app_scheduled_workout_show', {id: r.scheduledId}) }}">{{ r.label }}</a>
                                    <span class="kd-ranklist__val">{{ r.value }}</span>
                                    <span class="kd-ranklist__note">{{ r.date|date('d/m/Y') }}{{ r.note ? ' · ' ~ r.note }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>

                {# ========================= PRÉVU VS RÉALISÉ ======================== #}
                <section class="kd-card">
                    <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:git-compare') }} Prévu contre réel</h3>
                    {% if endu.comparison is empty %}
                        <div class="kd-empty">
                            {{ ux_icon('lucide:git-compare') }}
                            <div>Aucune séance prescrite avec une activité rattachée sur cette période.</div>
                        </div>
                    {% else %}
                        <p class="kd-card__note">Sur les seules séances qui portent un prescrit chiffré et une activité rattachée. La distance se compare là où elle était prescrite, la durée de même.</p>
                        {% for c in endu.comparison %}
                            <h4 class="kd-endu__sport">{{ activity.badge(c.activity) }} <span class="kd-deflist__note">{{ c.sessions }} séance{{ c.sessions > 1 ? 's' }}</span></h4>
                            <dl class="kd-deflist">
                                {% if c.distance %}
                                    <dt>Distance</dt>
                                    <dd>{{ c.distance.planned }} → <strong>{{ c.distance.actual }}</strong> <span class="kd-deflist__note">({{ c.distance.delta }}, {{ c.distance.percent > 0 ? '+' }}{{ c.distance.percent }} %)</span></dd>
                                {% endif %}
                                {% if c.duration %}
                                    <dt>Durée</dt>
                                    <dd>{{ c.duration.planned }} → <strong>{{ c.duration.actual }}</strong> <span class="kd-deflist__note">({{ c.duration.delta }}, {{ c.duration.percent > 0 ? '+' }}{{ c.duration.percent }} %)</span></dd>
                                {% endif %}
                                {% if c.pace %}
                                    <dt>{{ c.activity.value == 'cycling' ? 'Vitesse' : 'Allure' }}</dt>
                                    <dd>{{ c.pace.planned }} → <strong>{{ c.pace.actual }}</strong></dd>
                                {% endif %}
                            </dl>
                        {% endfor %}
                    {% endif %}
                </section>
            </div>
        </section>
    {% elseif tab.value == 'feeling' %}
        {# ================================ RESSENTI ===============================
           Forme 1-5 et difficulté 1-10, sur toutes les séances faites de la
           fenêtre. Valeur effective : la saisie Kadens, sinon la note de la
           montre (Intervals). Les deux axes se lisent séparément, et le taux de
           séances notées dit sur combien de séances reposent les moyennes. #}
        <section class="kd-section">
            <div class="kd-pagehead kd-pagehead--sub">
                <div>
                    <p class="kd-eyebrow kd-eyebrow--accent">Ressenti</p>
                    <h2 class="kd-title kd-title--sm">Comment ça s'est passé</h2>
                </div>
            </div>

            {% if feel.rated == 0 %}
                <div class="kd-card kd-empty kd-section__block">
                    {{ ux_icon('lucide:heart-pulse') }}
                    <div>
                        Aucune séance notée sur cette période.
                        La forme et la difficulté se saisissent à la fin d'une séance sur Kadens Live, sur la page d'une séance faite, ou sur la montre pour une sortie importée.
                    </div>
                </div>
            {% else %}
                <div class="kd-profile__tiles kd-section__block">
                    {% if feel.feeling is not null %}
                        <div class="kd-profile__tile">
                            <span class="kd-profile__tileicon">{{ ux_icon('lucide:heart-pulse') }}</span>
                            <div class="kd-stat__value">{{ feel.feelingLabel }}</div>
                            <div class="kd-stat__label">Forme moyenne · {{ feel.feeling|number_format(1, ',', ' ') }}/5</div>
                        </div>
                    {% endif %}
                    {% if feel.sessionRpe is not null %}
                        <div class="kd-profile__tile">
                            <span class="kd-profile__tileicon">{{ ux_icon('lucide:flame') }}</span>
                            <div class="kd-stat__value">{{ feel.sessionRpe|number_format(1, ',', ' ') }}<span class="kd-wk__unit">/10</span></div>
                            <div class="kd-stat__label">Difficulté moyenne · {{ feel.effortLabel|lower }}</div>
                        </div>
                    {% endif %}
                    <div class="kd-profile__tile">
                        <span class="kd-profile__tileicon">{{ ux_icon('lucide:clipboard-check') }}</span>
                        <div class="kd-stat__value">{{ (feel.coverage * 100)|round }} %</div>
                        <div class="kd-stat__label">Séances notées · {{ feel.rated }} sur {{ feel.done }}</div>
                    </div>
                </div>

                {# Deux rampes côte à côte, à l'échelle absolue de leur axe : une
                   barre pleine, c'est « très en forme » ou « maximal », pas la
                   meilleure semaine de la fenêtre. #}
                <div class="kd-grid kd-grid--2 kd-section__block">
                    {% for axis in [
                        {key: 'feeling', title: 'Forme', icon: 'lucide:heart-pulse', scale: 5, note: 'Forme moyenne, de très faible (1) à très en forme (5).'},
                        {key: 'sessionRpe', title: 'Difficulté', icon: 'lucide:flame', scale: 10, note: 'Difficulté moyenne des séances, sur 10.'},
                    ] %}
                        <section class="kd-card">
                            <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon(axis.icon) }} {{ axis.title }} {{ feel.granularity == 'week' ? 'semaine par semaine' : 'mois par mois' }}</h3>
                            <p class="kd-card__note">{{ axis.note }}{% if feel.truncated %} Les 24 dernières seulement.{% endif %}</p>

                            <div class="kd-statbars">
                                <div class="kd-prog__bars">
                                    {% for p in feel.points %}
                                        {% set value = attribute(p, axis.key) %}
                                        {% set height = axis.key == 'feeling' ? p.feelingHeightPct : p.rpeHeightPct %}
                                        {% set label = axis.key == 'feeling' ? p.feelingLabel : p.effortLabel %}
                                        <div class="kd-prog__col{{ value is null ? ' is-empty' }}">
                                            <div class="kd-prog__track">
                                                {% if value is not null %}
                                                    <span class="kd-prog__bar {{ axis.key == 'sessionRpe' ? 'kd-feelbar--rpe' : 'kd-feelbar--feel' }}"
                                                          style="height: {{ height }}%"
                                                          title="{{ p.label }} · {{ value|number_format(1, ',', ' ') }}/{{ axis.scale }} ({{ label }}) · {{ p.sessions }} séance{{ p.sessions > 1 ? 's' }}"></span>
                                                {% endif %}
                                            </div>
                                            <span class="kd-prog__wk">{{ p.short }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <table class="kd-sr-only">
                                <caption>{{ axis.title }} par {{ feel.granularity == 'week' ? 'semaine' : 'mois' }}</caption>
                                <thead><tr><th>Période</th><th>{{ axis.title }}</th><th>Séances notées</th></tr></thead>
                                <tbody>
                                    {% for p in feel.points %}
                                        {% set value = attribute(p, axis.key) %}
                                        <tr><td>{{ p.label }}</td><td>{{ value is null ? '—' : value|number_format(1, ',', ' ') ~ ' sur ' ~ axis.scale }}</td><td>{{ p.sessions }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </section>
                    {% endfor %}
                </div>

                {# Répartition de la forme : même barre empilée que les régions,
                   en dégradé d'encre (le dernier cran en simple contour). #}
                {% set feelTotal = feel.distribution|reduce((carry, d) => carry + d.sessions, 0) %}
                {% if feelTotal > 0 %}
                    <section class="kd-card kd-section__block">
                        <h3 class="kd-card__title kd-profile__grouphead">{{ ux_icon('lucide:pie-chart') }} Répartition de la forme</h3>
                        <p class="kd-card__note">Part des séances notées en forme, par niveau.</p>

                        <div class="kd-stack" role="img"
                             aria-label="{% for d in feel.distribution %}{{ d.level.label }} {{ d.percent|number_format(0) }} %{{ not loop.last ? ', ' }}{% endfor %}">
                            {% for d in feel.distribution|filter(d => d.sessions > 0) %}
                                <span class="kd-stack__seg kd-{{ d.tone }}" style="width: {{ d.percent }}%"></span>
                            {% endfor %}
                        </div>

                        <ul class="kd-legend">
                            {% for d in feel.distribution %}
                                <li class="kd-legend__item">
                                    <span class="kd-legend__key kd-{{ d.tone }}" aria-hidden="true"></span>
                                    {{ d.level.label }}
                                    <span class="kd-legend__val">{{ d.sessions }} · {{ d.percent|number_format(0) }} %</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
