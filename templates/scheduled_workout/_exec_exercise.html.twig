{# Le panneau d'UN exercice : ce qu'on a sous les yeux entre deux séries.

   Un seul est visible à la fois (le contrôleur `execlog` masque les autres).
   Tous sont rendus côté serveur : c'est la condition du hors ligne — la page
   doit être complète et autonome une fois en cache, on ne va pas rechercher un
   exercice sur le réseau au milieu d'une séance. Sans JS, ils s'affichent tous
   à la suite et la page reste utilisable.

   Cible d'un Turbo Stream (l'id doit survivre au remplacement) : chaque
   validation re-rend ce panneau seul.

   Attendus : stop (SheetStop), scheduled, token (csrf 'log{id}'). #}
{% set ex = stop.exercise %}
{% set isTime = ex.type is not null and ex.type.value == 'sets_time' %}

<section class="kd-execpanel{{ ex.complete ? ' is-complete' }}"
         id="exlog-{{ ex.prescribed.id }}"
         data-execlog-target="panel"
         data-execlog-rest-value="{{ ex.rest ?? '' }}"
         aria-labelledby="exlog-title-{{ ex.prescribed.id }}">

    <header class="kd-execpanel__head">
        <p class="kd-execpanel__context">
            <span class="kd-execpanel__step">{{ '%02d'|format(stop.ordinal) }}</span>
            {{ stop.block.role.label }}
            {%- if stop.block.label %} · {{ stop.block.label }}{% endif -%}
            {%- if stop.block.rounds > 1 %} · × {{ stop.block.rounds }} tours{% endif -%}
        </p>

        {# Nom d'exercice = contenu saisi : casse normale, jamais le condensé
           capitales (règle 4 du design system). #}
        <h2 class="kd-execpanel__name" id="exlog-title-{{ ex.prescribed.id }}">
            {{ ex.exercise ? ex.exercise.name : '—' }}
        </h2>

        <p class="kd-execpanel__meta">
            {% if stop.segmentLabel %}
                <span class="kd-execpanel__chip">
                    {{ ux_icon('lucide:link') }}
                    {{ stop.segmentKind == 'circuit' ? 'Circuit' : 'Superset' }} {{ ex.groupLabel }}
                </span>
            {% endif %}
            {% if ex.rest %}
                <span class="kd-execpanel__chip">{{ ux_icon('lucide:timer') }} repos {{ ex.rest }} s</span>
            {% endif %}
            {% if ex.prescribed.rpe %}
                <span class="kd-execpanel__chip">RPE {{ ex.prescribed.rpe }}</span>
            {% endif %}
            <span class="kd-execpanel__chip kd-execpanel__chip--count">
                {{- ex.doneCount }}/{{ ex.lineCount }} série{{ ex.lineCount > 1 ? 's' -}}
            </span>
        </p>
    </header>

    {% if not ex.perSet %}
        {# Types sans séries (course, AMRAP, durée…) : rien à dérouler, une seule
           bascule qui vaut « l'exercice est fait ». Sans ça une séance de course
           serait impointable. #}
        <p class="kd-execpanel__planned">{{ ex.values }}</p>
        <ol class="kd-execlines">
            {% include 'scheduled_workout/_exec_line.html.twig' with {
                ex: ex, line: ex.lines|first, scheduled: scheduled, token: token,
                isTime: isTime, bare: true
            } only %}
        </ol>
    {% else %}
        {# En-têtes de colonnes : les champs sont nus (pas de libellé par ligne),
           c'est ici qu'on dit ce qu'on saisit. #}
        <div class="kd-execcols" aria-hidden="true">
            <span class="kd-execcols__effort">{{ isTime ? 'Durée' : 'Reps' }}</span>
            <span class="kd-execcols__weight">Charge</span>
        </div>

        <ol class="kd-execlines">
            {% for line in ex.lines %}
                {% include 'scheduled_workout/_exec_line.html.twig' with {
                    ex: ex, line: line, scheduled: scheduled, token: token,
                    isTime: isTime, bare: false
                } only %}
            {% endfor %}
        </ol>

        {# Série faite en plus du prévu. Le modèle l'accepte sans rien changer :
           le pointage se fait sur un index, pas sur une ligne prescrite. Elle ne
           gonfle pas le total (la progression ne peut pas dépasser 100 %). #}
        <form method="post" action="{{ path('app_scheduled_workout_log', {id: scheduled.id}) }}"
              class="kd-execpanel__add" data-execlog-target="form">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="prescribedId" value="{{ ex.prescribed.id }}">
            <input type="hidden" name="setIndex" value="{{ ex.lines|length + 1 }}">
            {# Valeurs de la dernière ligne : ajouter une série, c'est en général
               refaire la précédente. #}
            {% set last = ex.lines|last %}
            {% if last %}
                <input type="hidden" name="reps" value="{{ last.log ? last.log.reps : last.plannedReps }}">
                <input type="hidden" name="weightKg" value="{{ last.log ? last.log.weightKg : last.plannedWeightKg }}">
                <input type="hidden" name="durationSeconds" value="{{ last.log ? last.log.durationSeconds : last.plannedDurationSeconds }}">
            {% endif %}
            <button type="submit" name="op" value="log" class="kd-execpanel__addbtn"
                    aria-label="Ajouter une série en plus du prévu">
                {{ ux_icon('lucide:plus') }}
            </button>
        </form>
    {% endif %}

    {% if ex.notes %}<p class="kd-execpanel__notes">{{ ex.notes|nl2br }}</p>{% endif %}

    {# Navigation d'un exercice à l'autre, à portée de pouce sous le tableau.
       Sans JS ce sont des ancres, la page défile au bon endroit. #}
    <nav class="kd-execpanel__nav">
        <a href="#exlog-{{ ex.prescribed.id }}" class="kd-execpanel__navbtn"
           data-action="execlog#previous" data-execlog-index-param="{{ stop.ordinal - 2 }}"
           {{ stop.ordinal <= 1 ? 'hidden' : '' }}>
            {{ ux_icon('lucide:arrow-left') }} Précédent
        </a>
        <a href="#exlog-{{ ex.prescribed.id }}" class="kd-execpanel__navbtn kd-execpanel__navbtn--next"
           data-action="execlog#next" data-execlog-index-param="{{ stop.ordinal }}">
            Suivant {{ ux_icon('lucide:arrow-right') }}
        </a>
    </nav>
</section>
