{% extends 'base.html.twig' %}

{% set workout = flat.workout %}
{% set st = scheduled.status.value %}
{% set isDone = st == 'done' %}

{% block title %}{{ workout.title }} — {{ scheduled.scheduledDate|date('d/m/Y') }}{% endblock %}

{% block body %}
    {# Séance dans son contexte daté. La page de bibliothèque (app_workout_show)
       montre la même séance mais ne connaît aucune date : c'est ici, et seulement
       ici, que se boucle le « prévu vs réalisé ».

       Même composant de lecture que la page de bibliothèque et la page publique,
       en `embed` pour pouvoir remplir le bloc `actions` du hero.

       `only` isole le composant : ce que le bloc `actions` utilise doit être
       passé ici explicitement, la portée du template appelant n'y entre pas. #}
    {% embed 'components/_workout_read.html.twig' with {
        flat: flat, summary: summary, blockStats: blockStats,
        scheduled: scheduled, st: st
    } only %}
        {% block actions %}
            <div class="kd-wk__bar">
                <a href="{{ path('app_calendar_index') }}" class="kd-wk__back">
                    {{ ux_icon('lucide:arrow-left') }} Calendrier
                </a>

                <div class="kd-wk__baractions">
                    <span class="kd-badge kd-badge--{{ st }}">
                        <span class="kd-badge__dot"></span>{{ scheduled.status.label }}
                    </span>
                    {% if is_granted('WORKOUT_EDIT', flat.workout) %}
                        <a href="{{ path('app_workout_edit', {id: flat.workout.id}) }}"
                           class="kd-btn kd-btn--sm kd-btn--onink">
                            {{ ux_icon('lucide:square-pen') }} Éditer
                        </a>
                    {% endif %}
                </div>
            </div>

            {# Noms français en dur, comme le calendrier : twig/intl-extra n'est
               pas installé et l'app est monolingue. #}
            {% set dayNames = {1: 'Lundi', 2: 'Mardi', 3: 'Mercredi', 4: 'Jeudi', 5: 'Vendredi', 6: 'Samedi', 7: 'Dimanche'} %}
            {% set monthNames = {1: 'janvier', 2: 'février', 3: 'mars', 4: 'avril', 5: 'mai', 6: 'juin',
                                 7: 'juillet', 8: 'août', 9: 'septembre', 10: 'octobre', 11: 'novembre', 12: 'décembre'} %}
            {% set d = scheduled.scheduledDate %}
            <p class="kd-wk__date">
                {{ ux_icon('lucide:calendar-days') }}
                {{ dayNames[d|date('N')] }} {{ d|date('j') }} {{ monthNames[d|date('n')] }} {{ d|date('Y') }}
            </p>
        {% endblock %}
    {% endembed %}

    {# ============================ PRÉVU VS RÉALISÉ ============================
       En bas de séance, à l'endroit où on arrive après avoir lu le programme.
       Le bouton bascule entre « prévue » et « faite » ; « manquée » reste au
       cycle rapide du calendrier, qui boucle sur les trois états. #}
    {% if is_granted('SCHEDULED_WORKOUT_EDIT', scheduled) %}
        <section class="kd-done" aria-labelledby="done-title">
            <h2 class="kd-done__title" id="done-title">Réalisé</h2>

            <form method="post" action="{{ path('app_scheduled_workout_status', {id: scheduled.id}) }}" class="kd-done__form">
                <input type="hidden" name="_token" value="{{ csrf_token('status' ~ scheduled.id) }}">
                {# Sans ça, l'endpoint renvoie au calendrier : on quitterait la page
                   à chaque bascule. #}
                <input type="hidden" name="return" value="schedule">
                <input type="hidden" name="status" value="{{ isDone ? 'planned' : 'done' }}">

                <div class="kd-field">
                    <label class="kd-label" for="completion-notes">Écart / ressenti (optionnel)</label>
                    <textarea id="completion-notes" name="completionNotes" rows="3"
                              class="kd-input kd-input--area"
                              placeholder="Charge revue à la baisse, dos raide…">{{ scheduled.completionNotes }}</textarea>
                </div>

                <button type="submit" class="kd-btn kd-btn--block {{ isDone ? 'kd-btn--secondary' : 'kd-btn--primary' }}">
                    {% if isDone %}
                        {{ ux_icon('lucide:rotate-ccw') }} Annuler « fait »
                    {% else %}
                        {{ ux_icon('lucide:check') }} Marquer fait
                    {% endif %}
                </button>
            </form>

            <div class="kd-done__secondary">
                <form method="post" action="{{ path('app_scheduled_workout_move', {id: scheduled.id}) }}" class="kd-done__move">
                    <input type="hidden" name="_token" value="{{ csrf_token('move' ~ scheduled.id) }}">
                    <input type="hidden" name="return" value="schedule">
                    <label class="kd-label" for="move-date">Déplacer</label>
                    <div class="kd-done__moverow">
                        <input type="date" id="move-date" name="scheduledDate"
                               value="{{ scheduled.scheduledDate|date('Y-m-d') }}" class="kd-input" required>
                        <button type="submit" class="kd-btn kd-btn--secondary">
                            {{ ux_icon('lucide:calendar-clock') }} Déplacer
                        </button>
                    </div>
                </form>

                <form method="post" action="{{ path('app_scheduled_workout_delete', {id: scheduled.id}) }}"
                      onsubmit="return confirm('Retirer cette séance du planning ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ scheduled.id) }}">
                    <button type="submit" class="kd-btn kd-btn--ghost kd-btn--danger">
                        {{ ux_icon('lucide:trash-2') }} Retirer du planning
                    </button>
                </form>
            </div>
        </section>
    {% endif %}
{% endblock %}
