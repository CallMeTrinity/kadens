{# Un bloc dans le compositeur (style 3a). En-tête inline (rôle / libellé / tours,
   déplacer, supprimer) puis les exercices en lignes compactes. Le corps du bloc
   est une zone de dépôt (glisser depuis la bibliothèque ou réordonner une ligne).
   Contexte hérité : workout, blockForms, prescribedForms, summaries. #}
{% set blockForm = blockForms[block.id] %}

<article class="kd-cblock"
         data-composer-target="block"
         data-block-id="{{ block.id }}"
         data-action="click->composer#activateBlock">

    <div class="kd-cblock__head">
        {{ form_start(blockForm, { attr: { class: 'kd-cblock__form' } }) }}
            <span class="kd-cblock__dot"></span>
            {{ form_widget(blockForm.role, { attr: {
                class: 'kd-cblock__role',
                'data-action': 'change->composer#submitForm',
            } }) }}
            {{ form_widget(blockForm.label, { attr: {
                class: 'kd-cblock__label',
                placeholder: 'intitulé libre',
                'data-action': 'change->composer#submitForm',
            } }) }}
            <div class="kd-cblock__rounds">
                <button type="button" class="kd-cblock__step" data-action="composer#roundsDec" aria-label="Moins de tours">−</button>
                {{ ux_icon('lucide:repeat') }}
                {{ form_widget(blockForm.rounds, { attr: {
                    class: 'kd-cblock__roundsval',
                    'data-action': 'change->composer#submitForm',
                    'aria-label': 'Nombre de tours',
                } }) }}
                <span class="kd-cblock__roundslabel">tours</span>
                <button type="button" class="kd-cblock__step" data-action="composer#roundsInc" aria-label="Plus de tours">+</button>
            </div>
        {{ form_end(blockForm) }}

        {# Actions du bloc en menu, pas en rangée d'icônes : les trois carrés
           passaient par-dessus le champ d'intitulé dès que la colonne se resserrait. #}
        <details class="kd-kebab kd-kebab--row kd-cblock__menu" data-controller="dismiss">
            <summary class="kd-kebab__trigger kd-kebab__trigger--plain" aria-label="Actions sur le bloc">
                {{ ux_icon('lucide:ellipsis') }}
            </summary>
            <div class="kd-kebab__panel">
                {{ include('components/_menu_form.html.twig', {
                    action: path('app_workout_block_move', {id: workout.id, blockId: block.id, direction: 'up'}),
                    token: csrf_token('block_move' ~ block.id),
                    icon: 'lucide:chevron-up',
                    label: 'Monter le bloc'
                }) }}
                {{ include('components/_menu_form.html.twig', {
                    action: path('app_workout_block_move', {id: workout.id, blockId: block.id, direction: 'down'}),
                    token: csrf_token('block_move' ~ block.id),
                    icon: 'lucide:chevron-down',
                    label: 'Descendre le bloc'
                }) }}
                {{ include('components/_menu_form.html.twig', {
                    action: path('app_workout_block_delete', {id: workout.id, blockId: block.id}),
                    token: csrf_token('block_delete' ~ block.id),
                    icon: 'lucide:x',
                    variant: 'danger',
                    label: 'Supprimer le bloc'
                }) }}
            </div>
        </details>
    </div>

    <div class="kd-cblock__items" data-composer-target="items" data-block-id="{{ block.id }}">
        {# Rendu segment par segment (SupersetGrouper) : un exercice isolé ou un
           groupe lié. Le DOM reste PLAT — les `.kd-cexo` doivent rester enfants
           directs du conteneur, SortableJS ne trie que ses enfants directs. Le
           groupe se lit à la classe et au rail de gauche, pas à un wrapper.

           L'ordre vient déjà du service (tri par position en mémoire) : après une
           mutation, la PersistentCollection garde son ordre de chargement, le
           #[OrderBy] ne s'appliquant qu'au load DB. #}
        {% for segment in segments[block.id]|default([]) %}
            {% set segLoop = loop %}
            {% for prescribed in segment.exercises %}
                <div class="kd-cexo
                            {{- segment.label ? ' kd-cexo--linked' }}
                            {{- segment.label and loop.first ? ' kd-cexo--linkstart' }}
                            {{- segment.label and loop.last ? ' kd-cexo--linkend' }}"
                     data-composer-target="exo"
                     data-prescribed-id="{{ prescribed.id }}"
                     data-block-id="{{ block.id }}">
                    {% if segment.label and loop.first %}
                        {# Nommé une fois en tête de groupe. Hors de .kd-cexo__row :
                           le stream ciblé qui re-rend une ligne ne l'emporte pas. #}
                        <p class="kd-cexo__caption">
                            {{ ux_icon('lucide:link') }}
                            {{ segment.kind == 'circuit' ? 'Circuit' : 'Superset' }} {{ segment.label }}
                            <span>· enchaîné sans repos</span>
                        </p>
                    {% endif %}
                    {{ include('workout/_cexo_row.html.twig', {
                        prescribed: prescribed,
                        summary: summaries[prescribed.id]|default(''),
                        groupLabel: segment.label ? segment.label ~ loop.index : null,
                        groupKind: segment.kind,
                        canLink: not (segLoop.first and loop.first)
                    }) }}

                    <div class="kd-cexo__params" id="cexo-params-{{ prescribed.id }}" hidden>
                        {# Conteneur re-rendu d'un bloc par les mutations de séries (stream
                           ciblant cet id). .kd-cexo__params (et son `hidden`) survit :
                           seul le contenu change, le panneau reste ouvert. #}
                        <div id="prescribed-params-{{ prescribed.id }}">
                            {{ include('workout/_prescribed_params.html.twig', {
                                prescribed: prescribed,
                                prescribedForm: prescribedForms[prescribed.id],
                                setForms: setForms
                            }) }}
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="kd-cblock__drop">Déposez un exercice ici</div>
        {% endfor %}
    </div>

    {# Chemin d'ajout attaché au bloc, HORS du conteneur trié : SortableJS calcule
       ses index sur les enfants directs de `items`, un bouton parmi eux décalerait
       le point de dépôt. Sur écran large il donne le focus à la bibliothèque
       latérale ; sous 900px, où elle n'est plus une colonne mais une feuille, il
       l'ouvre. Le glisser-déposer reste un raccourci de souris, jamais le seul
       chemin d'ajout. #}
    <button type="button" class="kd-cblock__addexo"
            data-action="composer#openLib"
            data-block-id="{{ block.id }}">
        {{ ux_icon('lucide:plus') }} Ajouter un exercice
    </button>
</article>
