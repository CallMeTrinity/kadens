{# Formulaire d'un exercice prescrit (édition). Les champs de valeurs pertinents
   sont montrés/masqués selon le type d'effort par le contrôleur Stimulus
   « prescription-fields ». Le nettoyage définitif se fait côté serveur.
   Paramètres : form (FormView), submit_label, auto_action.

   L'exercice n'est plus modifiable ici (on n'échange pas un exo une fois posé) :
   il est rappelé en lecture seule (badge d'activité + nom).

   auto_action (optionnel) : action Stimulus (ex. « change->composer#submitForm »)
   posée sur chaque champ pour un enregistrement automatique au changement. Quand il
   est fourni, le bouton d'enregistrement disparaît (tout est automatique). #}
{% import 'components/_activity.html.twig' as activity %}
{% set auto = auto_action|default(null) %}
{% set pe = form.vars.data %}
{% set exercise = pe.exercise %}
{# En mode « séries détaillées », les valeurs par série (reps/charge/durée) sont
   pilotées ligne par ligne : elles ne sont même pas déclarées dans le formulaire
   (option `detailed` de PrescribedExerciseType), on ne peut donc pas les rendre.
   Le compteur `sets`, lui, RESTE : il est synchronisé dans les deux sens avec la
   collection détaillée (le modifier ajoute/retire des séries de travail).
   Les champs transverses (repos/RPE/notes) restent aussi. #}
{% set scalar_overridden = pe.hasDetailedSets ? ['reps', 'weightKg', 'durationSeconds'] : [] %}
<div data-controller="prescription-fields"
     data-prescription-fields-map-value="{{ prescription_type_fields_map()|json_encode|e('html_attr') }}">
    {{ form_start(form, { attr: { class: 'kd-form' } }) }}
        {# Rappel de l'activité (le nom est déjà porté par la ligne parente) : donne
           le contexte utile pour lire les champs cardio (allure/zone/dénivelé). #}
        {% if exercise %}
            <p class="kd-prescribed__exo">{{ activity.badge(exercise.activity) }}</p>
        {% endif %}

        {{ form_row(form.prescriptionType, { attr: {
            'data-prescription-fields-target': 'type',
            'data-action': auto ? ('prescription-fields#update ' ~ auto) : 'prescription-fields#update',
        } }) }}

        <div class="kd-fieldrow">
            {% for field in ['sets', 'reps', 'weightKg', 'durationSeconds', 'distanceMeters', 'paceSecondsPerKm', 'intensityZone', 'elevationGainMeters', 'targetReps', 'capSeconds'] %}
                {% if field not in scalar_overridden %}
                    {% set opts = auto ? { attr: { 'data-action': auto } } : {} %}
                    {# Le compteur pilote la liste de séries : on le dit, et on précise
                       que l'échauffement n'entre pas dans le décompte. #}
                    {% if field == 'sets' and pe.hasDetailedSets %}
                        {% set opts = opts|merge({ help: 'Séries de travail — l\'échauffement n\'est pas compté.' }) %}
                    {% endif %}
                    <div class="kd-fieldrow__cell" data-prescription-fields-target="field" data-field="{{ field }}">
                        {{ form_row(attribute(form, field), opts) }}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="kd-fieldrow">
            <div class="kd-fieldrow__cell">{{ form_row(form.restSeconds, auto ? { attr: { 'data-action': auto } } : {}) }}</div>
            <div class="kd-fieldrow__cell">{{ form_row(form.rpe, auto ? { attr: { 'data-action': auto } } : {}) }}</div>
        </div>
        {{ form_row(form.notes, auto ? { attr: { 'data-action': auto } } : {}) }}

        {% if not auto %}
            <div class="kd-formactions">
                <button type="submit" class="kd-btn kd-btn--primary kd-btn--sm">
                    {{ ux_icon('lucide:check') }} {{ submit_label|default('Enregistrer') }}
                </button>
            </div>
        {% endif %}
    {{ form_end(form) }}
</div>
